<section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
        <div>
            <h1 class="hero__title" id="hero-title">@Hero.Title</h1>
            @if (!string.IsNullOrWhiteSpace(Hero.Lead))
            {
                <p class="hero__lead">@Hero.Lead</p>
            }
            <div class="doors">
                <a class="door door--primary" href="@Hero.StudentDoor.Url">
                    <span class="door__who">@Hero.StudentDoor.Who</span>
                    <span class="door__what">@Hero.StudentDoor.Label</span>
                    <Icon Name="arrow" />
                </a>
                <a class="door" href="@Hero.InstitutionDoor.Url">
                    <span class="door__who">@Hero.InstitutionDoor.Who</span>
                    <span class="door__what">@Hero.InstitutionDoor.Label</span>
                    <Icon Name="arrow" />
                </a>
            </div>
        </div>
        <DongSonDrum Class="drum" IdPrefix="hero-drum" Labels="_labels" />
    </div>
</section>

@code {
    [Parameter, EditorRequired] public HeroDto Hero { get; set; } = default!;
    [Parameter] public IReadOnlyList<CountryDto> Countries { get; set; } = [];

    private IReadOnlyList<DongSonDrum.DrumLabel> _labels = [];

    protected override void OnParametersSet()
        => _labels = Countries.Select(c => new DongSonDrum.DrumLabel(c.Name, c.SchoolCount > 0 ? c.SchoolCount : null)).ToList();
}
