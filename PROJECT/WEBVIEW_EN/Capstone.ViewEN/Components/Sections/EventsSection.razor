<section class="section" aria-labelledby="events-title">
    <div class="container">
        <div class="section__head">
            <div>
                <h2 class="section__title" id="events-title">Upcoming fairs and info sessions</h2>
                <p class="section__intro">Free to attend. Meet admissions officers in person in Hanoi and Ho Chi Minh City, or online.</p>
            </div>
            <a class="text-link" href="/events">See all events<Icon Name="arrow" /></a>
        </div>

        @if (Events.Count > 0)
        {
            <ul class="agenda">
                @foreach (var e in Events)
                {
                    <EventRow Event="e" />
                }
            </ul>
        }
        else
        {
            <EmptyState Title="No events scheduled right now"
                        Text="New fairs are announced here first. Leave your details and we'll invite you."
                        ActionUrl="/contact" ActionLabel="Get event invitations" />
        }
    </div>
</section>

@code {
    [Parameter] public IReadOnlyList<EventDto> Events { get; set; } = [];
}
