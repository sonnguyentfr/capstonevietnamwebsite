@page "/not-found"
@layout MainLayout

<Seo Title="Page not found" NoIndex="true" />

<PageHero Title="We couldn't find that page" Lead="The link may be old, or the page has moved. These are the places most visitors are looking for." />

<section class="section">
    <div class="container">
        <div class="service-list">
            <a class="service-row" href="/partners">
                <span class="service-row__icon"><Icon Name="graduation" /></span>
                <span><span class="service-row__title">Partner schools</span><span class="service-row__desc">Search schools and universities by destination and level.</span></span>
                <span class="service-row__go"><Icon Name="arrow" /></span>
            </a>
            <a class="service-row" href="/events">
                <span class="service-row__icon"><Icon Name="calendar" /></span>
                <span><span class="service-row__title">Events and fairs</span><span class="service-row__desc">Upcoming education fairs and info sessions.</span></span>
                <span class="service-row__go"><Icon Name="arrow" /></span>
            </a>
            <a class="service-row" href="/contact">
                <span class="service-row__icon"><Icon Name="mail" /></span>
                <span><span class="service-row__title">Contact a counsellor</span><span class="service-row__desc">Tell us what you were looking for and we'll point you to it.</span></span>
                <span class="service-row__go"><Icon Name="arrow" /></span>
            </a>
        </div>
    </div>
</section>
