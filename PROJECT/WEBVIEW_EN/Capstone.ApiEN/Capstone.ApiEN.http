###
# 400 + lỗi từng trường
POST {{api}}/leads
Content-Type: application/json

{ "role": "student", "fullName": "", "email": "not-an-email", "consent": false }

###
# 200 — Json mode ghi vào App_Data/leads.jsonl, Sql mode ghi vào CRM (WebView_TuVan_Upsert)
POST {{api}}/leads
Content-Type: application/json

{
  "role": "student",
  "fullName": "Nguyen Van An",
  "email": "an@example.com",
  "phone": "0912345678",
  "interest": "Study abroad advising",
  "message": "I'd like advice about applying to Ohio University.",
  "consent": true,
  "sourceUrl": "https://en.capstonevietnam.com/partners/ohio-university-102",
  "utmSource": "facebook",
  "utmMedium": "cpc",
  "utmCampaign": "fall-fair-2026"
}

