@{
    var _data = await SiteHelper.GetHeaderFooterDataAsync(SiteOptions.Value.PortalId);
    var _serverFilesBaseUrl = SiteOptions.Value.ServerFilesBaseUrl;
    var _footerLogo = !string.IsNullOrEmpty(_data.FooterLogo.Replace("/DATA", _serverFilesBaseUrl)) ? _data.FooterLogo.Replace("/DATA", _serverFilesBaseUrl) : "/static/img/logo-footer.png";
    var _siteName = !string.IsNullOrEmpty(_data.SiteName) ? _data.SiteName : "Capstone Vietnam";
}
<section class="home-hub-life">
    <div class="video-container">
        <iframe src="https://www.youtube.com/embed/MzCwaMUjlfQ?autoplay=1&amp;mute=1&amp;controls=0&amp;loop=1&amp;playlist=MzCwaMUjlfQ&amp;modestbranding=1&amp;showinfo=0&amp;rel=0" frameborder="0" allow="autoplay; fullscreen" allowfullscreen=""></iframe>
    </div>
</section>
<footer class="bg-primary-950">
    <div class="container">
        <div class="footer-top">
            <div class="logo">
                <a href="index.htm">
                    <img src="@_footerLogo" alt="@_siteName">
                </a>
            </div>
            <div class="right">
                <div class="top">
                    <div class="certification-item"><img src="/static/img/AUN-QA.png" alt="aunqa"><span>Chứng nhận kiểm định Chương trình đào tạo theo tiêu chuẩn AUN-QA</span></div>
                    <div class="certification-item"><img src="/static/img/CSGD.jpg" alt="csgd"><span>Chứng nhận kiểm định Cơ sở giáo dục theo tiêu chuẩn MOET</span></div>
                </div>
                <div class="iso">
                    <div class="certification-item"><img src="/static/img/iso.png" alt="iso"><span>Chứng nhận Hệ thống quản lý chất lượng theo tiêu chuẩn ISO 9001:2015 của Tổ chức Afnor Cộng hòa Pháp</span></div>
                    <div class="certification-item"><img src="/static/img/Logo-CEA-SAIGON.png" alt="cea"><span>Chứng nhận kiểm định Chương trình đào tạo theo tiêu chuẩn MOET</span></div>
                </div>
            </div>
        </div>
        <div class="footer-mid">
            @foreach (var branch in _data.Branches.Skip(1))
            {
                <div class="footer-block">
                    <h4 class="footer-title"><i class="fa-regular fa-location-dot"></i>&nbsp;&nbsp;@branch.Name</h4>
                    <ul class="footer-info">
                        <li>
                            <div class="content">
                                <p><strong>@branch.Name</strong></p>
                                @if (!string.IsNullOrEmpty(branch.Address))
                                {
                                    <p><i class="bx bx-home"></i>&nbsp;&nbsp;@branch.Address</p>
                                }
                                @if (!string.IsNullOrEmpty(branch.Phone))
                                {
                                    <p><i class="bx bx-phone"></i>&nbsp;&nbsp;Hotline: <a href="tel:@branch.Phone.Replace(" ", "")">@branch.Phone</a></p>
                                }
                                @if (!string.IsNullOrEmpty(branch.Email))
                                {
                                    <p><i class="bx bx-mail-send"></i>&nbsp;&nbsp;Email: <a href="mailto:@branch.Email">@branch.Email</a></p>
                                }
                            </div>
                        </li>
                    </ul>
                </div>
            }

            <div class="footer-block">
                <h4 class="footer-title">Thông tin chung</h4>
                <ul class="footer-menu">
                    <li><a href="#">Tin tức - Sự kiện</a></li>
                    <li><a href="#">Thư viện Văn bản - Biểu mẫu</a></li>
                    <li><a href="#">Góp ý - Liên hệ</a></li>
                </ul>
            </div>
            <div class="footer-block">
                <h4 class="footer-title">Link liên kết</h4>
                <ul class="footer-menu">
                    <li><a href="#">Các bài báo của Giám đốc điều hành</a></li>
                    <li><a href="#">Báo chí viết vê Capstone Vietnam</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bot">
            <div class="social-list">
                <ul>
                    @if (!string.IsNullOrEmpty(_data.Social.Facebook))
                    {
                        <li><a href="@_data.Social.Facebook" target="_blank" rel="noopener"><i class="fa-brands fa-facebook-f"></i></a></li>
                    }
                    @if (!string.IsNullOrEmpty(_data.Social.Youtube))
                    {
                        <li><a href="@_data.Social.Youtube" target="_blank" rel="noopener"><i class="fa-brands fa-youtube"></i></a></li>
                    }
                    @if (!string.IsNullOrEmpty(_data.Social.Twitter))
                    {
                        <li><a href="@_data.Social.Twitter" target="_blank" rel="noopener"><i class="fa-brands fa-x-twitter"></i></a></li>
                    }
                    @if (!string.IsNullOrEmpty(_data.Social.LinkedIn))
                    {
                        <li><a href="@_data.Social.LinkedIn" target="_blank" rel="noopener"><i class="fa-brands fa-linkedin-in"></i></a></li>
                    }
                    @if (!string.IsNullOrEmpty(_data.Social.Instagram))
                    {
                        <li><a href="@_data.Social.Instagram" target="_blank" rel="noopener"><i class="fa-brands fa-instagram"></i></a></li>
                    }
                </ul>
            </div>
            <div class="copyright">
                <p>Copyright © 2009 Capstone Việt Nam.</p>
                <p>All Rights Reserved.</p>
            </div>
        </div>
    </div>
</footer>
<div class="cta-fixed">
    <ul>
        <li class="back-to-top active"><a href="javascript:;" title="Back to top"><i class="fa-light fa-arrow-up-to-line"></i><span>TOP</span></a></li>
        @if (!string.IsNullOrEmpty(_data.SitePhone))
        {
            <li><a href="tel:@_data.SitePhone.Replace(" ", "")"><i class="fa-light fa-phone"></i><span>Gọi điện</span></a></li>
        }
        @if (!string.IsNullOrEmpty(_data.SiteEmail))
        {
            <li><a href="mailto:@_data.SiteEmail"><i class="fa-light fa-envelope"></i><span>Email</span></a></li>
        }
        @if (!string.IsNullOrEmpty(_data.Social.Zalo))
        {
            <li><a href="@_data.Social.Zalo" target="_blank" rel="noopener"><img src="/static/img/zalo.png" alt=""><span>Zalo</span></a></li>
        }
        @if (!string.IsNullOrEmpty(_data.Social.Facebook))
        {
            <li><a href="@_data.Social.Facebook" target="_blank" rel="noopener"><img src="/static/img/mess.png" alt=""><span>Message</span></a></li>
        }
    </ul>
</div>