@{
    var _data = await SiteHelper.GetHeaderFooterDataAsync(SiteOptions.Value.PortalId);
    var _serverFilesBaseUrl = SiteOptions.Value.ServerFilesBaseUrl;
    var _headerLogo = !string.IsNullOrEmpty(_data.HeaderLogo.Replace("/DATA", _serverFilesBaseUrl)) ? _data.HeaderLogo.Replace("/DATA", _serverFilesBaseUrl) : "/static/img/logo.png";
    var _siteName = !string.IsNullOrEmpty(_data.SiteName) ? _data.SiteName : "Capstone Vietnam";
}
<header>
    <div class="header-top">
        <div class="container flex items-center justify-between">
            <div class="logo">
                <a href="/"><img src="@_headerLogo" alt="@_siteName"></a>
            </div>
            <div class="header-right">
                <div class="button-contact">
                    <ul class="contact-list">
                        @foreach (var branch in _data.Branches.Skip(1))
                        {
                            <li>
                                <span>
                                    @branch.Name
                                @if (!string.IsNullOrEmpty(branch.Phone))
                                {
                                    <a href="tel:@branch.Phone.Replace(" ", "")">@branch.Phone</a>
                                    }
                                </span>
                                @if (!string.IsNullOrEmpty(branch.Address))
                                {
                                    <span class="small"><i class="fa fa-map-marker" aria-hidden="true"></i> @branch.Address</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
                <div class="button-language">
                    <ul class="language-list">
                        <li class="active"><a href="#">VN</a></li>
                        <li><a href="#">EN</a></li>
                    </ul>
                </div>
                <div class="button-search"><i class="fa-solid fa-search"></i></div>
                <button id="buttonMenu" type="button" data-target="#toggleMenu" aria-controls="toggleMenu">
                    <span class="line"></span><span class="line"></span><span class="line"></span>
                    <span id="pulseMe">
                        <span class="bar left"></span><span class="bar top"></span>
                        <span class="bar right"></span><span class="bar bottom"></span>
                    </span>
                </button>
            </div>
        </div>
    </div>
    <div class="header-bot bg-primary-900">
        <div class="container header-bot-wrap">
            <nav class="navbar-nav">
                @await Component.InvokeAsync("Menu")
            </nav>
        </div>
    </div>
</header>
<div class="mobile-wrap">
    <div class="navbar-nav-list"></div>
</div>
<div class="search-wrap" id="searchOverlay" role="dialog" aria-modal="true" aria-label="Tìm kiếm">
    <div class="search-overlay-bg"></div>
    <div class="search-overlay-inner">
        <button class="search-close" id="searchClose" type="button" aria-label="Đóng tìm kiếm">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <p class="search-hint">Nhập từ khóa để tìm kiếm</p>
        <form class="searchbox" action="/tim-kiem" method="get" autocomplete="off">
            <div class="searchbox-field">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input type="text" name="q" placeholder="Tìm kiếm..." autofocus spellcheck="false">
                <button type="submit" class="search-btn">Tìm kiếm</button>
            </div>
        </form>
        <div class="search-suggestions">
            <span class="search-suggestion-label">Gợi ý:</span>
            <a href="/tim-kiem?q=du+hoc" class="search-tag">Du học</a>
            <a href="/tim-kiem?q=hoc+bong" class="search-tag">Học bổng</a>
            <a href="/tim-kiem?q=tu+van" class="search-tag">Tư vấn</a>
            <a href="/tim-kiem?q=visa" class="search-tag">Visa</a>
        </div>
    </div>
</div>
<script>
    (function () {
        var overlay = document.getElementById('searchOverlay');
        var closeBtn = document.getElementById('searchClose');
        var openBtn = document.querySelector('.button-search');
        var input = overlay ? overlay.querySelector('input[name="q"]') : null;

        function openSearch() {
            overlay.classList.add('is-open');
            document.body.style.overflow = 'hidden';
            setTimeout(function () { if (input) input.focus(); }, 320);
        }
        function closeSearch() {
            overlay.classList.remove('is-open');
            document.body.style.overflow = '';
        }

        if (openBtn) openBtn.addEventListener('click', openSearch);
        if (closeBtn) closeBtn.addEventListener('click', closeSearch);

        if (overlay) {
            overlay.querySelector('.search-overlay-bg').addEventListener('click', closeSearch);
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeSearch();
            });
        }
    })();
</script>
