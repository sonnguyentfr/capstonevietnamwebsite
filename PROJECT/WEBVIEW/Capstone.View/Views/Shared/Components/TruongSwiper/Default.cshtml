@using NVCMS.WebView.Data.ViewModels
@model IEnumerable<TruongCardViewModel>

@{
    var title = ViewData["ViewTitle"]?.ToString() ?? "";
    var hasItems = Model != null && Model.Any();
}

@if (hasItems)
{
    var uniqueId = "ts-" + Guid.NewGuid().ToString("N").Substring(0, 8);
    <div class="truong-swiper-component" id="wrap-@uniqueId" data-aos="fade-up" data-aos-delay="100">
        @if (!string.IsNullOrEmpty(title))
        {
            <div class="truong-swiper-header">
                <h3 class="truong-swiper-title">@title</h3>
            </div>
        }
        <button type="button" class="truong-swiper-prev ts-nav" aria-label="Trước"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
        <button type="button" class="truong-swiper-next ts-nav" aria-label="Sau"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
        <div class="swiper @uniqueId truong-swiper-container">
            <div class="swiper-wrapper">
                @* Moi slide = 1 cot gom 2 card xep doc => carousel hien thi 2 dong *@
                @foreach (var pair in Model!.Chunk(2))
                {
                    <div class="swiper-slide">
                        <div class="ts-col">
                            @foreach (var t in pair)
                            {
                                var hasCover = !string.IsNullOrWhiteSpace(t.CoverUrl);
                                var hasLogo = !string.IsNullOrWhiteSpace(t.LogoUrl);
                            <a href="@t.DetailUrl" class="school-card school-card--slide">
                                <div class="school-card__cover@(hasCover ? "" : " school-card__cover--empty")">
                                    @if (hasCover)
                                    {
                                        <img cdn-src="@t.CoverUrl" cdn-w="540" cdn-h="340" cdn-mode="crop"
                                             alt="@t.NameofSchool" loading="lazy" />
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-building-columns" aria-hidden="true"></i>
                                    }
                                    @if (t.IsPartner)
                                    {
                                        <span class="school-card__badge">Đối tác</span>
                                    }
                                </div>
                                <div class="school-card__body">
                                    <div class="school-card__logo-wrap">
                                        @if (hasLogo)
                                        {
                                            <img cdn-src="@t.LogoUrl"
                                                 cdn-w="240"
                                                 cdn-h="240"
                                                 cdn-mode="pad"
                                                 alt="Logo @t.NameofSchool"
                                                 loading="lazy" />
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
                                        }
                                    </div>
                                    <h4 class="school-card__name">@t.NameofSchool</h4>
                                    <div class="school-card__meta">
                                        @if (!string.IsNullOrEmpty(t.CountryName))
                                        {
                                            <span class="school-card__meta-item">
                                                <i class="fa fa-globe"></i> @t.CountryName
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(t.StateName))
                                        {
                                            <span class="school-card__meta-item">
                                                <i class="fa fa-map-marker-alt"></i> @t.StateName
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(t.SchoolTypeLabelVN))
                                        {
                                            <span class="school-card__meta-item school-card__type">
                                                <i class="fa fa-school"></i> @t.SchoolTypeLabelVN
                                            </span>
                                        }
                                        @if (t.TuitionDisplay.HasValue && t.TuitionDisplay > 0)
                                        {
                                            <span class="school-card__meta-item school-card__tuition">
                                                <i class="fa fa-dollar-sign"></i>
                                                @t.TuitionDisplay.Value.ToString("N0") / năm
                                            </span>
                                        }
                                    </div>
                                </div>
                            </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="ts-progress swiper-pagination" aria-hidden="true"></div>
    </div>

    <script>
        (function () {
            document.addEventListener('DOMContentLoaded', function () {
                if (typeof Swiper === 'undefined') return;
                new Swiper('.@uniqueId', {
                    slidesPerView: 1.15,
                    spaceBetween: 14,
                    loop: false,
                    watchOverflow: true,
                    grabCursor: true,
                    pagination: { el: '#wrap-@uniqueId .ts-progress', type: 'progressbar' },
                    navigation: {
                        nextEl: '#wrap-@uniqueId .truong-swiper-next',
                        prevEl: '#wrap-@uniqueId .truong-swiper-prev'
                    },
                    breakpoints: {
                        560:  { slidesPerView: 2, spaceBetween: 16 },
                        900:  { slidesPerView: 3, spaceBetween: 20 },
                        1200: { slidesPerView: 4, spaceBetween: 24 }
                    }
                });
            });
        })();
    </script>
}
