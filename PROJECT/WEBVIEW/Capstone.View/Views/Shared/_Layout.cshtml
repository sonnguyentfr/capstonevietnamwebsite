<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="format-detection" content="telephone=no">
    <link rel="icon" href="/static/img/favicon.ico" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    @* CSS thu vien *@
    <link rel="stylesheet" href="/static/css/global.min.css">
    <link rel="stylesheet" href="/static/css/aos.css">
    <link rel="stylesheet" href="/static/css/main.min.css">
    <link rel="stylesheet" href="/static/css/site.css">
    @* Fonts / Icons *@
    <link rel="stylesheet" href="/static/css/font.css">
    <link rel="stylesheet" href="/static/fonts/font-awesome.min.css">
    <link rel="stylesheet" href="/static/fonts/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="/static/fonts/fontIcon/style.css">
    <link rel="stylesheet" href="/static/fonts/lora/stylesheet.css">
    <link rel="stylesheet" href="/static/fonts/boxicons.min.css">
    <link rel="stylesheet" href="/static/fonts/themify-icons.css">
    <title>@ViewData["Title"] - Capstone Vietnam</title>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div id="fb-root"></div>

    @await Html.PartialAsync("_Header")

    <main>
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer")

    <script src="/static/js/global.min.js"></script>
    <script src="/static/js/aos.js"></script>
    <script src="/static/js/main.min.js"></script>
    <script src="/static/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
