@{
    // Load site settings once per request — result is cached by portalId
    var _portalId = SiteOptions.Value.PortalId;
    var _headerFooterData = await SiteHelper.GetHeaderFooterDataAsync(_portalId);
    var _siteName = !string.IsNullOrEmpty(_headerFooterData.SiteName) ? _headerFooterData.SiteName : "Capstone Vietnam";
    var _metaDesc = ViewData["MetaDescription"] as string ?? "Capstone có ý nghĩa là thành tựu cao nhất hay nói cách khác là những gì tốt nhất mà một cá nhân hoặc một tổ chức có thể đạt được";
    var _metaImg   = ViewData["MetaImage"]   as string ?? "/static/img/og-default.jpg";
    var _canonical = ViewData["CanonicalUrl"] as string;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="format-detection" content="telephone=no">
    <link rel="icon" href="/static/img/favicon.ico" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    @* CSS thu vien *@
    <link rel="stylesheet" href="/static/css/global.min.css">
    <link rel="stylesheet" href="/static/css/aos.css">
    <link rel="stylesheet" href="/static/css/main.min.css">
    <link rel="stylesheet" href="/static/css/site.css">
    <link rel="stylesheet" href="/static/css/events.css">
    @* Fonts / Icons *@
    <link rel="stylesheet" href="/static/css/font.css">
    <link rel="stylesheet" href="/static/fonts/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="/static/fonts/fontIcon/style.css">
    <link rel="stylesheet" href="/static/fonts/lora/stylesheet.css">
    <link rel="stylesheet" href="/static/fonts/boxicons.min.css">
    <link rel="stylesheet" href="/static/fonts/themify-icons.css">
    <title>@ViewData["Title"] - @_siteName</title>
    <meta name="description" content="@_metaDesc">
    @if (_canonical != null) {
        <link rel="canonical" href="@_canonical">
    }
    @* Open Graph *@
    <meta property="og:type"        content="website">
    <meta property="og:site_name"   content="@_siteName">
    <meta property="og:title"       content="@ViewData["Title"] - @_siteName">
    <meta property="og:description" content="@_metaDesc">
    <meta property="og:image"       content="@_metaImg">
    @if (_canonical != null) {
        <meta property="og:url" content="@_canonical">
    }
    @* Twitter Card *@
    <meta name="twitter:card"        content="summary_large_image">
    <meta name="twitter:title"       content="@ViewData["Title"] - @_siteName">
    <meta name="twitter:description" content="@_metaDesc">
    <meta name="twitter:image"       content="@_metaImg">
    @* Inject custom <head> code from admin (Google Tag Manager, analytics, etc.) *@
    @if (!string.IsNullOrEmpty(_headerFooterData.HeaderCode))
    {
        @Html.Raw(_headerFooterData.HeaderCode)
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div id="fb-root"></div>

    @await Html.PartialAsync("_Header")

    <main>
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer")

    <script src="/static/js/global.min.js"></script>
    <script src="/static/js/aos.js"></script>
    <script src="/static/js/main.min.js"></script>
    <script src="/static/js/site.js"></script>
    @* Inject custom footer scripts from admin *@
    @if (!string.IsNullOrEmpty(_headerFooterData.FooterCode))
    {
        @Html.Raw(_headerFooterData.FooterCode)
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
