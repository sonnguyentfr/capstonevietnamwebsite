<!-- Cong cu tim truong -->
<section class="home-our-research section-large bg-neutral-50">
    <div class="container">
        <h2 class="site-title text-center" data-aos="flip-left" data-aos-delay="100">CONG CU TIM TRUONG</h2>
        <div class="mt-8">
            <div class="school-search-form" data-aos="fade-up" data-aos-delay="100">
                <input type="text" id="search-ten-truong" placeholder="TEN TRUONG...">
                <select id="search-quoc-gia">
                    <option value="" disabled selected>QUOC GIA +</option>
                    <option>My</option>
                    <option>Canada</option>
                    <option>Anh</option>
                    <option>Uc</option>
                    <option>Ireland</option>
                    <option>Thuy si</option>
                    <option>Singapore</option>
                </select>
                <select id="search-bac-hoc">
                    <option value="" disabled selected>BAC HOC +</option>
                    <option>Trung hoc</option>
                    <option>Cao dang</option>
                    <option>Dai hoc</option>
                    <option>Sau dai hoc</option>
                </select>
                <select id="search-nganh-hoc">
                    <option value="" disabled selected>NGANH HOC +</option>
                    <option>Kinh te</option>
                    <option>Quan tri kinh doanh</option>
                    <option>Cong nghe thong tin</option>
                    <option>Khoa hoc may tinh</option>
                    <option>Nghe thuat</option>
                    <option>Tam ly hoc</option>
                </select>
                <select id="search-hoc-phi">
                    <option value="" disabled selected>HOC PHI +</option>
                    <option>Duoi 10.000 USD</option>
                    <option>10.000 - 20.000 USD</option>
                    <option>20.000 - 40.000 USD</option>
                    <option>Tren 40.000 USD</option>
                </select>
            </div>
            <div class="school-search-btn-container">
                <button class="school-search-btn" onclick="timTruong()">TIM THONG TIN TRUONG</button>
            </div>
        </div>
    </div>
</section>

