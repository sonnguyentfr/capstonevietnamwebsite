<!-- Dang ky tu van -->
<section class="home-about section-large bg-primary-50">
    <div class="container">
        <div class="row items-center">
            <div class="col w-full lg:w-1/2">
                <h2 class="site-title">Dang ky tu van</h2>
                <p class="mt-4">Moi su hop tac tot dep deu bat dau tu mot cuoc tro chuyen.
                Hay lien he voi chung toi, moi mong muon cua ban se duoc lang nghe.</p>
            </div>
            <div class="col w-full lg:w-1/2 mt-8 lg:mt-0">
                <form class="contact-form" id="form-tu-van" method="post" action="/dang-ky-tu-van">
                    <select name="HinhThucTuVan">
                        <option value="" disabled selected>Hinh thuc tu van</option>
                        <option value="online">Online</option>
                        <option value="offline">Truc tiep</option>
                    </select>
                    <input type="text" name="HoTen" placeholder="Ho va ten *" required>
                    <input type="tel" name="DienThoai" placeholder="So dien thoai *" required>
                    <input type="email" name="Email" placeholder="Email *" required>
                    <select name="DichVu">
                        <option value="" disabled selected>Dich vu quan tam</option>
                        <option>Tu van du hoc</option>
                        <option>Tu van dinh cu</option>
                        <option>Career Coach</option>
                        <option>Visa du hoc</option>
                    </select>
                    <label class="checkbox-label">
                        <input type="checkbox" name="DongY" required>
                        Toi dong y voi cac dieu khoan bao mat thong tin cua Capstone
                    </label>
                    <button type="submit" class="btn-solid active">
                        <span>GUI</span><i class="fa-regular fa-arrow-right"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

