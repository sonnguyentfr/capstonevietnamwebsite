<!-- Cong cu tim truong -->
<section class="school-finder-section section-large">
    <div class="school-finder-bg">
        <div class="school-finder-overlay"></div>
        <div class="container school-finder-inner">
            <div class="school-finder-header" data-aos="fade-up" data-aos-delay="100">
                <span class="school-finder-label"><i class="fa-solid fa-magnifying-glass"></i> Công cụ tìm trường</span>
                <h2 class="school-finder-title">Tìm Trường Phù Hợp Với Bạn</h2>
                <p class="school-finder-desc">Chọn quốc gia, bậc học, ngành học và mức học phí để tìm trường lý tưởng</p>
            </div>

            <!-- Keyword search -->
            <div class="school-finder-search" data-aos="fade-up" data-aos-delay="150">
                <div class="school-finder-input-wrap">
                    <i class="fa-solid fa-school school-finder-input-icon"></i>
                    <input type="text" id="sf-ten" placeholder="Nhập tên trường bạn muốn tìm...">
                </div>
            </div>

            <!-- Filter rows -->
            <div class="school-finder-filters" data-aos="fade-up" data-aos-delay="200">

                <!-- Quoc gia -->
                <div class="sf-filter-group">
                    <div class="sf-filter-label"><i class="fa-solid fa-earth-asia"></i> Quốc gia</div>
                    <div class="sf-chips" id="sf-quocgia-chips">
                        <button type="button" class="sf-chip active" data-value=""><i class="fa-solid fa-globe"></i> Tất cả</button>
                        <button type="button" class="sf-chip" data-value="38">
                            <img src="/static/img/flags/us.svg" alt="" class="sf-chip-flag" onerror="this.style.display='none'">🇺🇸 Mỹ
                        </button>
                        <button type="button" class="sf-chip" data-value="3">
                            <img src="/static/img/flags/ca.svg" alt="" class="sf-chip-flag" onerror="this.style.display='none'">🇨🇦 Canada
                        </button>
                        <button type="button" class="sf-chip" data-value="1">
                            <img src="/static/img/flags/au.svg" alt="" class="sf-chip-flag" onerror="this.style.display='none'">🇦🇺 Úc
                        </button>
                        <button type="button" class="sf-chip" data-value="28">
                            <img src="/static/img/flags/gb.svg" alt="" class="sf-chip-flag" onerror="this.style.display='none'">🇬🇧 Anh
                        </button>
                        <button type="button" class="sf-chip" data-value="401">🇮🇪 Ireland</button>
                        <button type="button" class="sf-chip" data-value="23">🇨🇭 Thụy Sĩ</button>
                        <button type="button" class="sf-chip" data-value="99">🇳🇿 New Zealand</button>
                    </div>
                </div>

                <!-- Bac hoc -->
                <div class="sf-filter-group">
                    <div class="sf-filter-label"><i class="fa-solid fa-graduation-cap"></i> Bậc học</div>
                    <div class="sf-chips" id="sf-loai-chips">
                        <button type="button" class="sf-chip active" data-value=""><i class="fa-solid fa-list"></i> Tất cả</button>
                        <button type="button" class="sf-chip" data-value="BF"><i class="fa-solid fa-school"></i> Trung học</button>
                        <button type="button" class="sf-chip" data-value="2Y"><i class="fa-solid fa-building-columns"></i> Cao đẳng</button>
                        <button type="button" class="sf-chip" data-value="4Y"><i class="fa-solid fa-university"></i> Đại học</button>
                        <button type="button" class="sf-chip" data-value="GR"><i class="fa-solid fa-user-graduate"></i> Sau đại học</button>
                        <button type="button" class="sf-chip" data-value="ESL"><i class="fa-solid fa-language"></i> Anh ngữ ESL</button>
                    </div>
                </div>

                <!-- Hoc phi -->
                <div class="sf-filter-group">
                    <div class="sf-filter-label"><i class="fa-solid fa-dollar-sign"></i> Học phí (USD/năm)</div>
                    <div class="sf-chips" id="sf-tuition-chips">
                        <button type="button" class="sf-chip active" data-value=""><i class="fa-solid fa-list"></i> Tất cả</button>
                        <button type="button" class="sf-chip" data-value="10000">Dưới 10.000</button>
                        <button type="button" class="sf-chip" data-value="20000">10.000 – 20.000</button>
                        <button type="button" class="sf-chip" data-value="35000">20.000 – 35.000</button>
                        <button type="button" class="sf-chip" data-value="50000">Trên 35.000</button>
                    </div>
                </div>

            </div>

            <!-- Hidden selects for form submit -->
            <input type="hidden" id="sf-quocgia-val" name="QuocGia">
            <input type="hidden" id="sf-loai-val" name="Loai">
            <input type="hidden" id="sf-tuition-val" name="TuitionMax">

            <!-- CTA -->
            <div class="school-finder-cta" data-aos="fade-up" data-aos-delay="250">
                <button type="button" class="sf-search-btn" id="sf-submit-btn">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <span>TÌM TRƯỜNG NGAY</span>
                </button>
                <a class="sf-link-btn" href="/tim-truong">
                    <i class="fa-solid fa-sliders"></i>
                    <span>Tìm kiếm nâng cao</span>
                </a>
                <a class="sf-link-btn" href="/tim-nganh-hoc">
                    <i class="fa-solid fa-book-open"></i>
                    <span>Tìm ngành học</span>
                </a>
            </div>
        </div>
    </div>
</section>
<script>
    (function() {
        // Single-select chip groups
        document.querySelectorAll('.sf-chips').forEach(function(group) {
            group.querySelectorAll('.sf-chip').forEach(function(chip) {
                chip.addEventListener('click', function() {
                    group.querySelectorAll('.sf-chip').forEach(function(c) { c.classList.remove('active'); });
                    chip.classList.add('active');
                    var groupId = group.id;
                    var val = chip.dataset.value;
                    if (groupId === 'sf-quocgia-chips') document.getElementById('sf-quocgia-val').value = val;
                    if (groupId === 'sf-loai-chips') document.getElementById('sf-loai-val').value = val;
                    if (groupId === 'sf-tuition-chips') document.getElementById('sf-tuition-val').value = val;
                });
            });
        });

        document.getElementById('sf-submit-btn').addEventListener('click', function() {
            var params = new URLSearchParams();
            var ten = document.getElementById('sf-ten').value.trim();
            var qg = document.getElementById('sf-quocgia-val').value;
            var loai = document.getElementById('sf-loai-val').value;
            var tuition = document.getElementById('sf-tuition-val').value;
            if (ten) params.set('ten', ten);
            if (qg) params.set('quocgiaids', qg);
            if (loai) params.set('loai', loai);
            if (tuition) params.set('tuitionmax', tuition);
            window.location.href = '/tim-truong' + (params.toString() ? '?' + params.toString() : '');
        });

        document.getElementById('sf-ten').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') document.getElementById('sf-submit-btn').click();
        });
    })();
</script>

