@model NVCMS.WebView.Data.ViewModels.TruongDetailViewModel
@{
    ViewData["Title"] = Model.NameofSchool;
    bool is4Y  = Model.Loai is "4Y" or "2Y" or "GR";
    bool isBF  = Model.Loai is "BF" or "HS";
    bool isESL = Model.Loai is "ESL";
    var  a4    = Model.Admis4Year;

    // Các bậc đào tạo có trong trường (dựa vào dữ liệu học phí)
    bool hasUnder = is4Y && (a4?.TuitionUnder.HasValue == true || a4?.ScholarshipUnder == true);
    bool hasGrad  = is4Y && (a4?.TuitionGrad.HasValue  == true || a4?.ScholarshipGrad  == true);
    bool hasAss   = is4Y && (a4?.TuitionAss.HasValue   == true || a4?.ScholarshipAss   == true);
    bool hasESL4Y = is4Y && (a4?.TuitionESL.HasValue   == true || a4?.ScholarshipESL   == true);
}

<!-- Cover -->
<section class="truong-hero" style="@(!string.IsNullOrEmpty(Model.CoverUrl) ? $"background-image:url('{Model.CoverUrl}')" : "background:#1e3a5f")">
    <div class="truong-hero__overlay"></div>
    <div class="container truong-hero__content">
        <div class="truong-hero__logo">
            <img cdn-src="@Model.LogoUrl" alt="Logo @Model.NameofSchool" />
        </div>
        <div class="truong-hero__info">
            <div class="truong-hero__badges">
                @if (Model.IsPartner)
                {
                    <span class="badge badge--partner"><i class="fa-solid fa-handshake"></i> Đối tác Capstone</span>
                }
                @if (!string.IsNullOrEmpty(Model.CountryName))
                {
                    <span class="badge"><i class="fa-solid fa-location-dot"></i> @Model.CountryName</span>
                }
                @if (!string.IsNullOrEmpty(Model.Loai))
                {
                    var loaiLabel = Model.Loai switch
                    {
                        "4Y" => "Đại học",
                        "2Y" => "Cao đẳng",
                        "GR" => "Sau đại học",
                        "BF" => "Trung học",
                        "HS" => "Trung học",
                        "ESL" => "Anh ngữ ESL",
                        _ => Model.Loai
                    };
                    <span class="badge"><i class="fa-solid fa-graduation-cap"></i> @loaiLabel</span>
                }
            </div>
            <h1 class="truong-hero__name">@Model.NameofSchool</h1>
            @if (!string.IsNullOrEmpty(Model.ThanhPholongannhat))
            {
                <p class="truong-hero__city"><i class="fa-solid fa-map-pin"></i> @Model.ThanhPholongannhat</p>
            }
            @if (is4Y && (hasUnder || hasGrad || hasAss || hasESL4Y))
            {
                <div class="truong-hero__levels">
                    @if (hasUnder) { <span class="badge badge--level"><i class="fa-solid fa-graduation-cap"></i> Đại học</span> }
                    @if (hasGrad)  { <span class="badge badge--level"><i class="fa-solid fa-user-graduate"></i> Sau đại học</span> }
                    @if (hasAss)   { <span class="badge badge--level"><i class="fa-solid fa-school"></i> Cao đẳng</span> }
                    @if (hasESL4Y) { <span class="badge badge--level"><i class="fa-solid fa-language"></i> ESL</span> }
                </div>
            }
        </div>
    </div>
</section>

<!-- Quick info bar -->
<section class="truong-meta-bar bg-primary-950">
    <div class="container truong-meta-bar__inner">
        @if (!string.IsNullOrEmpty(Model.Namthanhlap))
        {
            <div class="truong-meta-item">
                <i class="fa-solid fa-calendar"></i>
                <span>Thành lập @Model.Namthanhlap</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.Website))
        {
            <div class="truong-meta-item">
                <i class="fa-solid fa-globe"></i>
                <a href="@Model.Website" target="_blank" rel="noopener">Website</a>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.Address))
        {
            <div class="truong-meta-item"><i class="fa-solid fa-location-dot"></i> @Model.Address</div>
        }
        
    </div>
</section>

<div class="container section-large">
    <div class="truong-layout">
        <!-- Main content -->
        <div class="truong-layout__main">

            <!-- Giới thiệu -->
            @if (!string.IsNullOrEmpty(Model.Info))
            {
                <div class="truong-section">
                    <h2 class="truong-section__title">Giới thiệu về trường</h2>
                    <div class="rich-text">@Html.Raw(Model.Info)</div>
                </div>
            }
            <!-- Giới thiệu -->
            @if (!string.IsNullOrEmpty(Model.Descreption))
            {
                <div class="truong-section">
                    <h2 class="truong-section__title">Điểm mạnh</h2>
                    <div class="rich-text">@Html.Raw(Model.Descreption)</div>
                </div>
            }
            <!-- Video -->
            @if (!string.IsNullOrEmpty(Model.VideoLink))
            {
                var _embedUrl = ContentUrlHelper.ToYouTubeEmbedUrl(Model.VideoLink);
                @if (_embedUrl is not null)
                {
                    <div class="truong-section">
                        <h2 class="truong-section__title">Video giới thiệu</h2>
                        <div class="video-embed">
                            <iframe src="@_embedUrl" frameborder="0"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                    allowfullscreen loading="lazy" title="@Model.NameofSchool" width="90%" height="400px"></iframe>
                        </div>
                    </div>
                }
            }

            <!-- Ngành học -->
            @if (Model.Majors.Any())
            {
                <div class="truong-section">
                    <h2 class="truong-section__title">Ngành học</h2>
                    <div class="major-tags">
                        @foreach (var m in Model.Majors)
                        {
                            <a class="major-tag" href="/tim-truong?MajorId=@m.Id">@(m.TitleVN ?? m.Title)</a>
                        }
                    </div>
                </div>
            }

            <!-- ==================== ĐẠI HỌC / CAO ĐẲNG layout ==================== -->
            @if (is4Y)
            {
              @if (a4 is not null)
              {
                var a = a4;
                <div class="truong-section">
                    <h2 class="truong-section__title">Thông tin tuyển sinh</h2>
                    <div class="info-grid">
                        @if (a.FallUnder.HasValue || a.SpringUnder.HasValue || a.RollingUnder == true)
                        {
                            <div class="info-item">
                                <span class="info-label"><i class="fa-solid fa-calendar-days"></i> Hạn nộp hồ sơ</span>
                                <span class="info-value">
                                    @if (a.RollingUnder == true)
                                    {
                                        <text>Tuyển sinh liên tục</text>
                                    }
                                    else
                                    {
                                        @if (a.FallUnder.HasValue)
                                        {
                                            <text>Fall: @a.FallUnder.Value.ToString("dd/MM/yyyy")  </text>
                                        }
                                        @if (a.SpringUnder.HasValue)
                                        {
                                            <text>Spring: @a.SpringUnder.Value.ToString("dd/MM/yyyy")</text>
                                        }
                                    }
                                </span>
                            </div>
                        }
                        @if (a.FallGrad.HasValue || a.RollingGrad == true)
                        {
                            <div class="info-item">
                                <span class="info-label"><i class="fa-solid fa-calendar-check"></i> Hạn nộp HS (Sau đại học)</span>
                                <span class="info-value">
                                    @if (a.RollingGrad == true) { <text>Tuyển sinh liên tục</text> }
                                    else { @a.FallGrad!.Value.ToString("dd/MM/yyyy") }
                                </span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(a.ToefliBTUnder))
                        {
                            <div class="info-item">
                                <span class="info-label"><i class="fa-solid fa-file-pen"></i> TOEFL iBT</span>
                                <span class="info-value">@a.ToefliBTUnder</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(a.IELTSUnder))
                        {
                            <div class="info-item">
                                <span class="info-label"><i class="fa-solid fa-file-pen"></i> IELTS</span>
                                <span class="info-value">@a.IELTSUnder</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(a.DuolingoUnder))
                        {
                            <div class="info-item">
                                <span class="info-label"><i class="fa-solid fa-d"></i> Duolingo</span>
                                <span class="info-value">@a.DuolingoUnder</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(a.OtherTestUnder))
                        {
                            <div class="info-item">
                                <span class="info-label"><i class="fa-solid fa-certificate"></i> Chứng chỉ khác</span>
                                <span class="info-value">@a.OtherTestUnder</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(a.ApplicationFeeUnder))
                        {
                            <div class="info-item">
                                <span class="info-label"><i class="fa-solid fa-file-invoice-dollar"></i> Phí nộp hồ sơ</span>
                                <span class="info-value">@a.ApplicationFeeUnder</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="truong-section">
                    <h2 class="truong-section__title">Học phí &amp; Chi phí</h2>
                    @{
                        bool hasTuition = a.TuitionUnder.HasValue || a.TuitionGrad.HasValue || a.TuitionAss.HasValue || a.TuitionESL.HasValue;
                        bool hasCost    = a.LivingCost.HasValue || a.InsuranceCost.HasValue || a.OtherCost.HasValue;
                    }
                    @if (hasTuition)
                    {
                        <div class="cost-table">
                            <table>
                                <thead><tr><th>Bậc học</th><th>Học phí/năm (USD)</th></tr></thead>
                                <tbody>
                                    @if (a.TuitionUnder.HasValue)
                                    {
                                        <tr><td><span class="badge badge--level-sm">Đại học</span></td><td><strong>$@a.TuitionUnder.Value.ToString("N0")</strong></td></tr>
                                    }
                                    @if (a.TuitionGrad.HasValue)
                                    {
                                        <tr><td><span class="badge badge--level-sm">Sau đại học</span></td><td><strong>$@a.TuitionGrad.Value.ToString("N0")</strong></td></tr>
                                    }
                                    @if (a.TuitionAss.HasValue)
                                    {
                                        <tr><td><span class="badge badge--level-sm">Cao đẳng</span></td><td><strong>$@a.TuitionAss.Value.ToString("N0")</strong></td></tr>
                                    }
                                    @if (a.TuitionESL.HasValue)
                                    {
                                        <tr><td><span class="badge badge--level-sm">ESL</span></td><td><strong>$@a.TuitionESL.Value.ToString("N0")</strong></td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    @if (hasCost)
                    {
                        <h3 class="truong-subsection__title">Chi phí khác ước tính/năm</h3>
                        <div class="cost-table">
                            <table>
                                <thead><tr><th>Khoản</th><th>USD/năm</th></tr></thead>
                                <tbody>
                                    @if (a.LivingCost.HasValue)
                                    {
                                        <tr><td><i class="fa-solid fa-house"></i> Chi phí sinh hoạt</td><td>$@a.LivingCost.Value.ToString("N0")</td></tr>
                                    }
                                    @if (a.InsuranceCost.HasValue)
                                    {
                                        <tr><td><i class="fa-solid fa-shield-heart"></i> Bảo hiểm</td><td>$@a.InsuranceCost.Value.ToString("N0")</td></tr>
                                    }
                                    @if (a.OtherCost.HasValue)
                                    {
                                        <tr><td><i class="fa-solid fa-ellipsis"></i> Chi phí khác</td><td>$@a.OtherCost.Value.ToString("N0")</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    @if (!hasTuition && !hasCost)
                    {
                        <div class="no-data-notice">
                            <i class="fa-regular fa-clock"></i>
                            <span>Thông tin học phí chưa được cập nhật. Vui lòng <a href="/dang-ky-tu-van">liên hệ Capstone</a> để được tư vấn.</span>
                        </div>
                    }
                </div>

                @if (a.ScholarshipUnder == true || a.ScholarshipGrad == true || a.ScholarshipAss == true || a.ScholarshipESL == true)
                {
                    <div class="truong-section">
                        <h2 class="truong-section__title"><i class="fa-solid fa-award"></i> Học bổng</h2>
                        <div class="scholarship-grid">
                            @if (a.ScholarshipUnder == true)
                            {
                                <div class="scholarship-card">
                                    <div class="scholarship-card__level"><i class="fa-solid fa-graduation-cap"></i> Đại học</div>
                                    <div class="scholarship-card__value">@(string.IsNullOrEmpty(a.ScholarshipUnderRangeVN) ? "Có học bổng" : a.ScholarshipUnderRangeVN)</div>
                                </div>
                            }
                            @if (a.ScholarshipGrad == true)
                            {
                                <div class="scholarship-card">
                                    <div class="scholarship-card__level"><i class="fa-solid fa-user-graduate"></i> Sau đại học</div>
                                    <div class="scholarship-card__value">@(string.IsNullOrEmpty(a.ScholarshipGradRangeVN) ? "Có học bổng" : a.ScholarshipGradRangeVN)</div>
                                </div>
                            }
                            @if (a.ScholarshipAss == true)
                            {
                                <div class="scholarship-card">
                                    <div class="scholarship-card__level"><i class="fa-solid fa-school"></i> Cao đẳng</div>
                                    <div class="scholarship-card__value">@(string.IsNullOrEmpty(a.ScholarshipAssRangeVN) ? "Có học bổng" : a.ScholarshipAssRangeVN)</div>
                                </div>
                            }
                            @if (a.ScholarshipESL == true)
                            {
                                <div class="scholarship-card">
                                    <div class="scholarship-card__level"><i class="fa-solid fa-language"></i> ESL</div>
                                    <div class="scholarship-card__value">@(string.IsNullOrEmpty(a.ScholarshipESLRangeVN) ? "Có học bổng" : a.ScholarshipESLRangeVN)</div>
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(a.ScholarshipNoteVN))
                        {
                            <p class="scholarship-note"><i class="fa-solid fa-circle-info"></i> @a.ScholarshipNoteVN</p>
                        }
                        @if (!string.IsNullOrEmpty(a.FinancialAidNote))
                        {
                            <div class="financial-aid-box">
                                <h3><i class="fa-solid fa-hand-holding-dollar"></i> Hỗ trợ tài chính</h3>
                                <p>@a.FinancialAidNote</p>
                            </div>
                        }
                    </div>
                }

                <div class="truong-section">
                    <h2 class="truong-section__title">Thống kê sinh viên</h2>
                    <div class="stats-row">
                        @if (a.NOSTotalUnder.HasValue)
                        {
                            <div class="stat-item"><span class="stat-num">@a.NOSTotalUnder.Value.ToString("N0")</span><span class="stat-label">Tổng sinh viên</span></div>
                        }
                        @if (a.NOSInternationalUnder.HasValue)
                        {
                            <div class="stat-item"><span class="stat-num">@a.NOSInternationalUnder.Value.ToString("N0")</span><span class="stat-label">Sinh viên quốc tế</span></div>
                        }
                        @if (a.NOSVNUnder.HasValue)
                        {
                            <div class="stat-item"><span class="stat-num">@a.NOSVNUnder.Value.ToString("N0")</span><span class="stat-label">Sinh viên Việt Nam</span></div>
                        }
                        @if (!string.IsNullOrEmpty(a.GraduationRate))
                        {
                            <div class="stat-item"><span class="stat-num">@a.GraduationRate</span><span class="stat-label">Tỷ lệ tốt nghiệp</span></div>
                        }
                        @if (!string.IsNullOrEmpty(a.EmploymentRateAfterGraduation))
                        {
                            <div class="stat-item"><span class="stat-num">@a.EmploymentRateAfterGraduation</span><span class="stat-label">Tỷ lệ có việc làm</span></div>
                        }
                    </div>
                </div>
              }
              else
              {
                <div class="no-data-section">
                    <i class="fa-regular fa-clock fa-2x"></i>
                    <h3>Thông tin tuyển sinh đang được cập nhật</h3>
                    <p>Capstone đang trong quá trình xác nhận thông tin chi tiết với trường. Vui lòng liên hệ để được tư vấn trực tiếp.</p>
                    <a class="btn-solid active" href="/dang-ky-tu-van"><i class="fa-solid fa-paper-plane"></i> Đăng ký tư vấn</a>
                </div>
              }
            }

            <!-- ==================== TRUNG HỌC layout ==================== -->
            @if (isBF && Model.AdmisBF is not null)
            {
                var b = Model.AdmisBF;
                <div class="truong-section">
                    <h2 class="truong-section__title">Thông tin tuyển sinh</h2>
                    <div class="info-grid">
                        @if (b.GradesFrom.HasValue && b.GradesTo.HasValue)
                        {
                            <div class="info-item">
                                <span class="info-label"><i class="fa-solid fa-school"></i> Khối lớp</span>
                                <span class="info-value">Lớp @b.GradesFrom đến lớp @b.GradesTo</span>
                            </div>
                        }
                        @if (b.AdmFall.HasValue || b.AdmRoll == true)
                        {
                            <div class="info-item">
                                <span class="info-label"><i class="fa-solid fa-calendar-days"></i> Hạn nộp hồ sơ</span>
                                <span class="info-value">
                                    @(b.AdmRoll == true ? "Tuyển sinh liên tục" : b.AdmFall?.ToString("dd/MM/yyyy"))
                                </span>
                            </div>
                        }
                        @if (b.APCourse == true)
                        {
                            <div class="info-item"><span class="info-label">AP Courses</span><span class="info-value badge badge--yes">Có</span></div>
                        }
                        @if (b.IBCourse == true)
                        {
                            <div class="info-item"><span class="info-label">IB Programme</span><span class="info-value badge badge--yes">Có</span></div>
                        }
                        @if (b.ESL == true)
                        {
                            <div class="info-item"><span class="info-label">ESL Support</span><span class="info-value badge badge--yes">Có</span></div>
                        }
                    </div>
                    @if (b.TESTToefl == true || b.TESTIELTS == true)
                    {
                        <h3 class="mt-6 font-semibold">Yêu cầu tiếng Anh</h3>
                        <div class="info-grid mt-2">
                            @if (b.TESTToefl == true)
                            {
                                <div class="info-item"><span class="info-label">TOEFL min.</span><span class="info-value">@b.TESTToeflMin</span></div>
                            }
                            @if (b.TESTIELTS == true)
                            {
                                <div class="info-item"><span class="info-label">IELTS min.</span><span class="info-value">@b.TESTIELTSMin</span></div>
                            }
                        </div>
                    }
                </div>

                <div class="truong-section">
                    <h2 class="truong-section__title">Học phí & Chi phí</h2>
                    <div class="cost-table">
                        <table>
                            <thead><tr><th>Khoản</th><th>USD/năm</th></tr></thead>
                            <tbody>
                                @if (b.Tuition.HasValue)
                                {
                                    <tr><td>Học phí</td><td>@b.Tuition.Value.ToString("N0")</td></tr>
                                }
                                @if (b.COSRoom.HasValue)
                                {
                                    <tr><td>Ký túc xá / Ăn</td><td>@b.COSRoom.Value.ToString("N0")</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (b.ScholarshipInternation == true)
                {
                    <div class="truong-section">
                        <h2 class="truong-section__title"><i class="fa-solid fa-award"></i> Học bổng quốc tế</h2>
                        <p>@(b.ScholarshipInternationRangVN ?? "Có học bổng dành cho học sinh quốc tế")</p>
                    </div>
                }

                @if (b.SummerProgram == true)
                {
                    <div class="truong-section">
                        <h2 class="truong-section__title"><i class="fa-solid fa-sun"></i> Chương trình hè</h2>
                        <div class="info-grid">
                            @if (!string.IsNullOrEmpty(b.SummerProgramAges))
                            {
                                <div class="info-item"><span class="info-label">Độ tuổi</span><span class="info-value">@b.SummerProgramAges</span></div>
                            }
                            @if (!string.IsNullOrEmpty(b.SummerProgramCOST))
                            {
                                <div class="info-item"><span class="info-label">Chi phí</span><span class="info-value">@b.SummerProgramCOST</span></div>
                            }
                        </div>
                    </div>
                }

                <div class="truong-section">
                    <h2 class="truong-section__title">Ký túc xá</h2>
                    <div class="info-grid">
                        @if (b.HousingBF == true)
                        {
                            <div class="info-item"><span class="info-label">Ký túc xá trường</span><span class="info-value badge badge--yes">Có</span></div>
                        }
                        @if (b.HousingHome == true)
                        {
                            <div class="info-item"><span class="info-label">Homestay</span><span class="info-value badge badge--yes">Có</span></div>
                        }
                    </div>
                </div>
            }

            <!-- ==================== ESL layout ==================== -->
            @if (isESL && Model.AdmisESL is not null)
            {
                var e = Model.AdmisESL;
                <div class="truong-section">
                    <h2 class="truong-section__title">Chương trình Anh ngữ (ESL)</h2>
                    @if (!string.IsNullOrEmpty(e.TypeOfCourse))
                    {
                        <p class="mb-4">@e.TypeOfCourse</p>
                    }
                    <div class="info-grid">
                        @if (!string.IsNullOrEmpty(e.LCName))
                        {
                            <div class="info-item"><span class="info-label">Tên khóa học</span><span class="info-value">@e.LCName</span></div>
                        }
                        @if (!string.IsNullOrEmpty(e.LCCost))
                        {
                            <div class="info-item"><span class="info-label">Chi phí</span><span class="info-value">@e.LCCost</span></div>
                        }
                        @if (e.RateOfStudent.HasValue)
                        {
                            <div class="info-item"><span class="info-label">Tỷ lệ SV/giáo viên</span><span class="info-value">@e.RateOfStudent:1</span></div>
                        }
                        @if (e.WorkOpp == true)
                        {
                            <div class="info-item"><span class="info-label">Cơ hội làm thêm</span><span class="info-value badge badge--yes">Có</span></div>
                        }
                        @if (!string.IsNullOrEmpty(e.Conditional))
                        {
                            <div class="info-item"><span class="info-label">Điều kiện nhập học</span><span class="info-value">@e.Conditional</span></div>
                        }
                    </div>
                </div>

                <div class="truong-section">
                    <h2 class="truong-section__title">Học phí & Chi phí</h2>
                    <div class="cost-table">
                        <table>
                            <thead><tr><th>Khoản</th><th>USD</th></tr></thead>
                            <tbody>
                                @if (e.Tuition.HasValue)
                                {
                                    <tr><td>Học phí</td><td>@e.Tuition.Value.ToString("N0")</td></tr>
                                }
                                @if (e.COSRoom.HasValue)
                                {
                                    <tr><td>Ký túc xá</td><td>@e.COSRoom.Value.ToString("N0")</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (e.Scholarship == true)
                {
                    <div class="truong-section">
                        <h2 class="truong-section__title"><i class="fa-solid fa-award"></i> Học bổng</h2>
                        <p>@(e.ScholarshipRange ?? "Có học bổng dành cho học viên")</p>
                    </div>
                }

                <div class="truong-section">
                    <h2 class="truong-section__title">Chỗ ở</h2>
                    <div class="info-grid">
                        @if (e.HousingOncampus == true)
                        {
                            <div class="info-item"><span class="info-label">Ký túc xá</span><span class="info-value badge badge--yes">Có</span></div>
                        }
                        @if (e.HousingHomeStay == true)
                        {
                            <div class="info-item"><span class="info-label">Homestay</span><span class="info-value badge badge--yes">Có</span></div>
                        }
                        @if (e.HousingApartment == true)
                        {
                            <div class="info-item"><span class="info-label">Căn hộ</span><span class="info-value badge badge--yes">Có</span></div>
                        }
                    </div>
                </div>

                <div class="truong-section">
                    <h2 class="truong-section__title">Thống kê</h2>
                    <div class="stats-row">
                        @if (e.NOSTotal.HasValue)
                        {
                            <div class="stat-item"><span class="stat-num">@e.NOSTotal</span><span class="stat-label">Tổng học viên</span></div>
                        }
                        @if (e.NOSInternation.HasValue)
                        {
                            <div class="stat-item"><span class="stat-num">@e.NOSInternation</span><span class="stat-label">Quốc tế</span></div>
                        }
                    </div>
                </div>
            }

        </div><!-- end main -->
        <!-- Sidebar -->
        <aside class="truong-layout__sidebar">
            <div class="sidebar-card">
                <h3 class="sidebar-card__title">Thông tin liên hệ</h3>
                @if (!string.IsNullOrEmpty(Model.ThanhPholongannhat))
                {
                    <p><i class="fa-solid fa-location-dot"></i> Thành phố: @Model.ThanhPholongannhat</p>
                }
                @if (!string.IsNullOrEmpty(Model.Loaitruongtext))
                {
                    <p><i class="fa-solid fa-graduation-cap"></i> Loại trường: @Model.Loaitruongtext</p>
                }
                @* @if (!string.IsNullOrEmpty(Model.Phone))
                {
                    <p><i class="fa-solid fa-phone"></i> <a href="tel:@Model.Phone.Replace(" ","")">@Model.Phone</a></p>
                }
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <p><i class="fa-solid fa-envelope"></i> <a href="mailto:@Model.Email">@Model.Email</a></p>
                } *@
                @if (!string.IsNullOrEmpty(Model.Website))
                {
                    <p><i class="fa-solid fa-globe"></i> <a href="@Model.Website" target="_blank" rel="noopener">Website chính thức</a></p>
                }
                @if (!string.IsNullOrEmpty(Model.Facebook))
                {
                    <p><i class="fa-brands fa-facebook"></i> <a href="@Model.Facebook" target="_blank" rel="noopener">Facebook</a></p>
                }
                @if (!string.IsNullOrEmpty(Model.Youtube))
                {
                    <p><i class="fa-brands fa-youtube"></i> <a href="@Model.Youtube" target="_blank" rel="noopener">YouTube</a></p>
                }
                @if (!string.IsNullOrEmpty(Model.Instagram))
                {
                    <p><i class="fa-brands fa-instagram"></i> <a href="@Model.Instagram" target="_blank" rel="noopener">Instagram</a></p>
                }
                @if (!string.IsNullOrEmpty(Model.Twitter))
                {
                    <p><i class="fa-brands fa-x-twitter"></i> <a href="@Model.Twitter" target="_blank" rel="noopener">X (Twitter)</a></p>
                }
            </div>

            @if (is4Y && (hasUnder || hasGrad || hasAss || hasESL4Y))
            {
                <div class="sidebar-card">
                    <h3 class="sidebar-card__title">Cấp bậc đào tạo</h3>
                    <ul class="sidebar-levels">
                        @if (hasUnder) { <li><i class="fa-solid fa-graduation-cap"></i> Đại học (Undergraduate)</li> }
                        @if (hasGrad)  { <li><i class="fa-solid fa-user-graduate"></i> Sau đại học (Graduate)</li> }
                        @if (hasAss)   { <li><i class="fa-solid fa-school"></i> Cao đẳng (Associate)</li> }
                        @if (hasESL4Y) { <li><i class="fa-solid fa-language"></i> Anh ngữ ESL</li> }
                    </ul>
                </div>
            }

            @if (Model.Admis4Year is not null)
            {
                var a = Model.Admis4Year;
                @if (!string.IsNullOrEmpty(a.MostMajor1) || !string.IsNullOrEmpty(a.MostMajor2))
                {
                    <div class="sidebar-card">
                        <h3 class="sidebar-card__title">Top ngành học nổi bật</h3>
                        <ol>
                            @if (!string.IsNullOrEmpty(a.MostMajor1)) { <li>@a.MostMajor1</li> }
                            @if (!string.IsNullOrEmpty(a.MostMajor2)) { <li>@a.MostMajor2</li> }
                            @if (!string.IsNullOrEmpty(a.MostMajor3)) { <li>@a.MostMajor3</li> }
                            @if (!string.IsNullOrEmpty(a.MostMajor4)) { <li>@a.MostMajor4</li> }
                            @if (!string.IsNullOrEmpty(a.MostMajor5)) { <li>@a.MostMajor5</li> }
                        </ol>
                    </div>
                }
            }

            @if (!string.IsNullOrEmpty(Model.Kiemdinh))
            {
                <div class="sidebar-card">
                    <h3 class="sidebar-card__title">Kiểm định</h3>
                    <p>@Model.Kiemdinh</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.TypeofRankingVN ?? Model.TypeofRanking))
            {
                <div class="sidebar-card">
                    <h3 class="sidebar-card__title">Xếp hạng</h3>
                    <p>@(Model.TypeofRankingVN ?? Model.TypeofRanking)</p>
                </div>
            }

            <div class="sidebar-card sidebar-card--cta">
                <h3 class="sidebar-card__title">Tư vấn ngay</h3>
                <p class="mb-4">Liên hệ Capstone để được tư vấn miễn phí về trường này</p>
                <a class="btn-solid active w-full" href="/dang-ky-tu-van">
                    <i class="fa-solid fa-paper-plane"></i> Đăng ký tư vấn
                </a>
            </div>

            @if (Model.RelatedNews.Any())
            {
                <div class="sidebar-card">
                    <h3 class="sidebar-card__title"><i class="fa-solid fa-newspaper"></i> Tin tức liên quan</h3>
                    <div class="truong-related-news">
                        @foreach (var n in Model.RelatedNews)
                        {
                            var nUrl = NVCMS.WebView.Data.Common.NewsUrlBuilder.BuildNewsUrl(n);
                            <a href="@nUrl" class="truong-related-news__item">
                                @if (!string.IsNullOrEmpty(n.ImagePath))
                                {
                                    <div class="truong-related-news__img">
                                        <img src="@n.ImagePath" alt="@n.Title" loading="lazy" />
                                    </div>
                                }
                                <div class="truong-related-news__info">
                                    <time>@n.PublishedDate.ToString("dd/MM/yyyy")</time>
                                    <p>@n.Title</p>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }
        </aside>
    </div>
</div>

@section Scripts {
    @Html.Raw(SeoSchemaHelper.CollegeOrUniversity(
        name: Model.NameofSchool ?? string.Empty,
        description: Model.Tomtat,
        url: Model.Website,
        logoUrl: Model.LogoUrl,
        imageUrl: Model.CoverUrl,
        address: Model.Address,
        country: Model.CountryName,
        telephone: Model.Phone,
        email: Model.Email,
        foundingYear: Model.Namthanhlap,
        sameAs: new[] { Model.Website }.Where(s => !string.IsNullOrWhiteSpace(s))!
    ))
}
