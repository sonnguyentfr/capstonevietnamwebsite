@{
    ViewData["Title"] = "Đăng ký đã đóng";
}

<section class="page-hero bg-primary-950">
    <div class="container">
        <h1 class="page-hero-title">Đăng ký đã đóng</h1>
    </div>
</section>

<section class="section-large">
    <div class="container">
        <div class="event-reg-closed" data-aos="fade-up">
            <div class="closed-icon">
                <i class="fa-solid fa-lock"></i>
            </div>
            <h2 class="closed-title">Đăng ký hiện không khả dụng</h2>
            <p class="closed-message">
                Sự kiện này chưa mở đăng ký hoặc đã kết thúc.
                Vui lòng kiểm tra lại thời gian hoặc xem các sự kiện khác.
            </p>
            <div class="mt-6">
                <a href="/su-kien" class="btn-solid">
                    <span>Xem tất cả sự kiện</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</section>
