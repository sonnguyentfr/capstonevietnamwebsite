@using NVCMS.WebView.Data.ViewModels
@model EventRegistrationPageViewModel

@{
    ViewData["Title"] = $"Đăng ký tham dự - {Model.Cat.CatName}";
}

@* ===== HERO ===== *@
<section class="page-hero bg-primary-950">
    <div class="container">
        <div class="breadcrumb" data-aos="fade-up">
            <a href="/">Trang chủ</a>
            <i class="fa-solid fa-chevron-right"></i>
            <a href="/su-kien">Sự kiện</a>
            <i class="fa-solid fa-chevron-right"></i>
            <a href="/su-kien/@NVCMS.WebView.Data.Common.SlugHelper.ToSlug(Model.Cat.CatName)-@Model.Cat.Id">@Model.Cat.CatName</a>
            <i class="fa-solid fa-chevron-right"></i>
            <span>Đăng ký tham dự</span>
        </div>
        <h1 class="page-hero-title" data-aos="fade-up" data-aos-delay="100">Đăng ký tham dự</h1>
        <p class="page-hero-desc" data-aos="fade-up" data-aos-delay="150">@Model.Cat.CatName</p>
    </div>
</section>

@* ===== FORM ===== *@
<section class="event-reg-section section-large">
    <div class="container">
        <div class="event-reg-layout">

            @* ── FORM COL ── *@
            <div class="event-reg-main" data-aos="fade-up">

                @if (TempData["RegWarning"] is string warn)
                {
                    <div class="alert alert-warning mb-6">
                        <i class="fa-solid fa-circle-exclamation"></i> @warn
                    </div>
                }
                @if (TempData["RegError"] is string err)
                {
                    <div class="alert alert-danger mb-6">
                        <i class="fa-solid fa-xmark-circle"></i> @err
                    </div>
                }

                <form asp-controller="EventRegistration" asp-action="Index"
                      method="post" id="event-reg-form" novalidate>
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Input.EventCatId" />

                    @* ── Location picker ── *@
                    <div class="form-group mb-5">
                        <label class="form-label">
                            <i class="fa-solid fa-location-dot"></i> Địa điểm tham dự
                            <span class="text-danger">*</span>
                        </label>
                        <select asp-for="Input.EventId" class="form-control" id="event-location-select">
                            @foreach (var ev in Model.Cat.Events)
                            {
                                var label = ev.Diadiem ?? ev.Title;
                                if (ev.Fromdatetime.HasValue)
                                    label += $" – {ev.Fromdatetime.Value:dd/MM/yyyy HH:mm}";
                                <option value="@ev.Id" selected="@(ev.Id == Model.PreselectedEventId || (Model.PreselectedEventId == 0 && ev.Id == Model.Cat.Events.First().Id) ? "selected" : null)">
                                    @label
                                </option>
                            }
                        </select>
                    </div>

                    @* ── Student info ── *@
                    <div id="student-fields">
                        <div class="form-row grid grid-cols-1 gap-4 mb-4" id="student-info-notice" style="display:none;">
                            <div class="alert alert-info">
                                <i class="fa-solid fa-circle-check"></i>
                                Chúng tôi đã tìm thấy thông tin của bạn. Vui lòng kiểm tra lại.
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label">
                                <i class="fa-solid fa-phone"></i> Số điện thoại
                                <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Input.SoDienThoai"
                                   id="inp-phone"
                                   class="form-control"
                                   placeholder="Ví dụ: 0912345678"
                                   autocomplete="tel" />
                            <span asp-validation-for="Input.SoDienThoai" class="field-validation-error"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label">
                                <i class="fa-solid fa-envelope"></i> Email
                            </label>
                            <input asp-for="Input.Email"
                                   id="inp-email"
                                   class="form-control"
                                   placeholder="email@example.com"
                                   autocomplete="email" />
                            <span asp-validation-for="Input.Email" class="field-validation-error"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label">
                                <i class="fa-solid fa-user"></i> Họ và tên
                                <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Input.HoVaTen"
                                   id="inp-name"
                                   class="form-control"
                                   placeholder="Nguyễn Văn A"
                                   autocomplete="name" />
                            <span asp-validation-for="Input.HoVaTen" class="field-validation-error"></span>
                        </div>

                        <div class="form-group mb-5">
                            <label class="form-label">
                                <i class="fa-solid fa-house"></i> Địa chỉ
                            </label>
                            <input asp-for="Input.DiaChi"
                                   id="inp-address"
                                   class="form-control"
                                   placeholder="Số nhà, đường, quận/huyện, tỉnh/thành" />
                        </div>
                    </div>

                    <div class="form-group mb-6">
                        <label class="form-check-label">
                            <input asp-for="Input.DongYDieuKhoan" type="checkbox" class="form-check-input" />
                            Tôi đồng ý với các <a href="#" target="_blank">điều khoản bảo mật</a>
                            của Capstone Vietnam. <span class="text-danger">*</span>
                        </label>
                        <span asp-validation-for="Input.DongYDieuKhoan" class="field-validation-error d-block mt-1"></span>
                    </div>

                    <div class="frm-btn">
                        <button type="submit" class="btn-solid">
                            <span>Đăng ký ngay</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </form>
            </div>

            @* ── SIDEBAR ── *@
            <aside class="event-reg-sidebar" data-aos="fade-left">
                <div class="sidebar-box">
                    <h3 class="sidebar-box-title">
                        <i class="fa-solid fa-calendar-days"></i> Thông tin sự kiện
                    </h3>
                    <ul class="sidebar-meta-list mt-4">
                        @if (Model.Cat.FromDate.HasValue)
                        {
                            <li>
                                <span class="meta-label">Từ ngày</span>
                                <span class="meta-value">@Model.Cat.FromDate.Value.ToString("dd/MM/yyyy")</span>
                            </li>
                        }
                        @if (Model.Cat.EndDate.HasValue)
                        {
                            <li>
                                <span class="meta-label">Đến ngày</span>
                                <span class="meta-value">@Model.Cat.EndDate.Value.ToString("dd/MM/yyyy")</span>
                            </li>
                        }
                    </ul>
                </div>

                @* Selected location preview *@
                <div class="sidebar-box mt-4" id="sidebar-location-info">
                    <h3 class="sidebar-box-title">
                        <i class="fa-solid fa-location-dot"></i> Địa điểm đã chọn
                    </h3>
                    <p id="sidebar-location-name" class="mt-2 font-semibold">
                        @(Model.Event.Diadiem ?? Model.Event.Title)
                    </p>
                    @if (Model.Event.Fromdatetime.HasValue)
                    {
                        <p id="sidebar-location-time" class="text-sm text-gray-500 mt-1">
                            <i class="fa-solid fa-clock"></i>
                            @Model.Event.Fromdatetime.Value.ToString("HH:mm, dd/MM/yyyy")
                        </p>
                    }
                </div>

                <div class="sidebar-box mt-4">
                    <a class="btn-outline w-full"
                           href="/su-kien/@NVCMS.WebView.Data.Common.SlugHelper.ToSlug(Model.Cat.CatName)-@Model.Cat.Id">
                        <i class="fa-solid fa-arrow-left"></i>
                        <span>Quay lại sự kiện</span>
                    </a>
                </div>
            </aside>

        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            // ── Location picker → update sidebar ─────────────────────────────────────
            var locationData = {
                @foreach (var ev in Model.Cat.Events)
                {
                        var diadiem = (ev.Diadiem ?? ev.Title ?? "").Replace("'", "\\'");
                        var time = ev.Fromdatetime.HasValue
                                ? ev.Fromdatetime.Value.ToString("HH:mm, dd/MM/yyyy")
                                : "";
                        @:@ev.Id: { name: '@diadiem', time: '@time' },
                }
            };

            var sel   = document.getElementById('event-location-select');
            var lname = document.getElementById('sidebar-location-name');
            var ltime = document.getElementById('sidebar-location-time');

            function updateSidebar() {
                var d = locationData[sel.value];
                if (!d) return;
                if (lname) lname.textContent = d.name;
                if (ltime) ltime.textContent = d.time ? '🕐 ' + d.time : '';
            }
            if (sel) sel.addEventListener('change', updateSidebar);

            // ── Real-time student lookup ──────────────────────────────────────────────
            var phoneInp   = document.getElementById('inp-phone');
            var emailInp   = document.getElementById('inp-email');
            var nameInp    = document.getElementById('inp-name');
            var addrInp    = document.getElementById('inp-address');
            var noticeRow  = document.getElementById('student-info-notice');
            var lockedFields = [nameInp, addrInp];
            var lookupTimer = null;

            function lockFields(lock) {
                lockedFields.forEach(function (f) {
                    if (!f) return;
                    f.readOnly = lock;
                    f.style.background = lock ? '#f9f9f9' : '';
                });
                if (noticeRow) noticeRow.style.display = lock ? '' : 'none';
            }

            function doLookup() {
                var phone = (phoneInp ? phoneInp.value : '').trim();
                var email = (emailInp ? emailInp.value : '').trim();
                if (!phone && !email) return;

                fetch('/EventRegistration/CheckStudent?phone=' + encodeURIComponent(phone) +
                      '&email=' + encodeURIComponent(email))
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        if (!d.found) { lockFields(false); return; }
                        if (nameInp)  nameInp.value  = d.fullName  || '';
                        if (addrInp)  addrInp.value  = d.diaChi    || '';
                        if (phoneInp && !phoneInp.value) phoneInp.value = d.phone || '';
                        if (emailInp && !emailInp.value) emailInp.value = d.email || '';
                        lockFields(true);
                    })
                    .catch(function () { /* silent */ });
            }

            function scheduleLookup() {
                clearTimeout(lookupTimer);
                lookupTimer = setTimeout(doLookup, 600);
            }

            [phoneInp, emailInp].forEach(function (el) {
                if (el) el.addEventListener('blur', doLookup);
                if (el) el.addEventListener('input', scheduleLookup);
            });
        })();
    </script>
}
