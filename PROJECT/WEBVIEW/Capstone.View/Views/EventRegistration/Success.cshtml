@{
    ViewData["Title"] = "Đăng ký thành công";
}

<section class="page-hero bg-primary-950">
    <div class="container">
        <h1 class="page-hero-title" data-aos="fade-up">Đăng ký thành công</h1>
    </div>
</section>

<section class="section-large">
    <div class="container">
        <div class="event-reg-success" data-aos="fade-up">
            <div class="success-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <h2 class="success-title">Chúc mừng bạn đã đăng ký thành công!</h2>
            @if (TempData["RegSuccess"] is string msg)
            {
                <p class="success-message">@msg</p>
            }
            else
            {
                <p class="success-message">
                    Đăng ký thành công. Email xác nhận sẽ được gửi trong ít phút.
                </p>
            }
            <div class="success-actions mt-8">
                <a href="/su-kien" class="btn-solid">
                    <span>Xem sự kiện khác</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
                <a href="/" class="btn-outline ml-4">
                    <i class="fa-solid fa-house"></i>
                    <span>Trang chủ</span>
                </a>
            </div>
        </div>
    </div>
</section>
