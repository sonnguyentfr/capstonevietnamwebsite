@using NVCMS.WebView.Data.ViewModels
@using NVCMS.WebView.Data.Common
@model PaginatedList<NewsItemViewModel>

@{
    ViewData["Title"] = "Tat ca tin tuc";
    var featured = Model.Items.Take(3).ToList();
    var rest     = Model.Items.Skip(3).ToList();
}

<section class="page-hero page-hero--news">
    <div class="container">
        <nav class="breadcrumb" aria-label="breadcrumb">
            <a href="/">Trang chu</a>
            <i class="fa-solid fa-chevron-right"></i>
            <a href="/cam-nang-su-kien-du-hoc-67">Cam nang &amp; Tin tuc</a>
            <i class="fa-solid fa-chevron-right"></i>
            <span>Tat ca tin tuc</span>
        </nav>
        <h1 class="page-hero__title" data-aos="fade-up">Tat ca tin tuc</h1>
    </div>
</section>

<section class="news-list-section">
    <div class="container">
        @if (!Model.Items.Any())
        {
            <div class="no-data-section">
                <i class="fa-regular fa-newspaper"></i>
                <p>Chua co bai viet nao.</p>
            </div>
        }
        else
        {
            if (featured.Any())
            {
                <div class="news-featured-grid">
                    @foreach (var item in featured)
                    {
                        var url = NewsUrlBuilder.BuildNewsUrl(item);
                        <article class="news-featured-card" data-aos="fade-up">
                            <a href="@url" class="news-featured-card__img-wrap">
                                <img src="@(!string.IsNullOrEmpty(item.ImagePath) ? item.ImagePath : "/static/images/no-photo.png")" alt="@item.Title" loading="lazy" />
                            </a>
                            <div class="news-featured-card__body">
                                <div class="news-card__meta">
                                    <span class="news-card__cat">@item.CategoryName</span>
                                    <time class="news-card__date" datetime="@item.PublishedDate.ToString("yyyy-MM-dd")">@item.PublishedDate.ToString("dd/MM/yyyy")</time>
                                </div>
                                <h2 class="news-featured-card__title"><a href="@url">@item.Title</a></h2>
                                @if (!string.IsNullOrEmpty(item.Summary)) { <p class="news-card__summary">@Html.Raw(item.Summary)</p> }
                            </div>
                        </article>
                    }
                </div>
            }

            if (rest.Any())
            {
                <div class="news-grid news-grid--4col">
                    @foreach (var item in rest)
                    {
                        var url = NewsUrlBuilder.BuildNewsUrl(item);
                        <article class="news-card" data-aos="fade-up">
                            <a href="@url" class="news-card__img-wrap">
                                <img src="@(!string.IsNullOrEmpty(item.ImagePath) ? item.ImagePath : "/static/images/no-photo.png")" alt="@item.Title" loading="lazy" />
                            </a>
                            <div class="news-card__body">
                                <div class="news-card__meta">
                                    <span class="news-card__cat">@item.CategoryName</span>
                                    <time class="news-card__date" datetime="@item.PublishedDate.ToString("yyyy-MM-dd")">@item.PublishedDate.ToString("dd/MM/yyyy")</time>
                                </div>
                                <h2 class="news-card__title"><a href="@url">@item.Title</a></h2>
                                @if (!string.IsNullOrEmpty(item.Summary)) { <p class="news-card__summary">@Html.Raw(item.Summary)</p> }
                                @if (!string.IsNullOrEmpty(item.Tacgia)) { <span class="news-card__author"><i class="fa-solid fa-pen-nib"></i> @item.Tacgia</span> }
                            </div>
                        </article>
                    }
                </div>
            }

            if (Model.TotalPages > 1)
            {
                <nav class="pagination" aria-label="Phan trang">
                    @if (Model.HasPrev) { <a href="/tin-tuc?page=@(Model.Page - 1)" class="pagination__btn"><i class="fa-solid fa-chevron-left"></i></a> }
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        if (p == Model.Page) { <span class="pagination__btn pagination__btn--active">@p</span> }
                        else if (p == 1 || p == Model.TotalPages || Math.Abs(p - Model.Page) <= 2) { <a href="/tin-tuc?page=@p" class="pagination__btn">@p</a> }
                        else if (Math.Abs(p - Model.Page) == 3) { <span class="pagination__ellipsis">...</span> }
                    }
                    @if (Model.HasNext) { <a href="/tin-tuc?page=@(Model.Page + 1)" class="pagination__btn"><i class="fa-solid fa-chevron-right"></i></a> }
                </nav>
            }
        }
    </div>
</section>
