@using NVCMS.WebView.Data.ViewModels
@using NVCMS.WebView.Data.Common
@model PaginatedList<NewsItemViewModel>

@{
    var tag           = ViewData["Tag"]?.ToString() ?? string.Empty;
    var upcomingEvents = ViewData["UpcomingEvents"] as List<EventsCatViewModel> ?? [];
    var baseUrl       = $"/tin-tuc/tag?tag={Uri.EscapeDataString(tag)}";
    ViewData["Title"] = $"#{tag}";
}

@* ── Hero ── *@
<section class="tag-hero">
    <div class="container">
        <nav class="breadcrumb tag-hero__breadcrumb" aria-label="breadcrumb">
            <a href="/">Trang chủ</a>
            <i class="fa-solid fa-chevron-right"></i>
            <a href="/tin-tuc">Tin tức</a>
            <i class="fa-solid fa-chevron-right"></i>
            <span>#@tag</span>
        </nav>
        <div class="tag-hero__body" data-aos="fade-up">
            <span class="tag-hero__badge"><i class="fa-solid fa-tag"></i> Tag</span>
            <h1 class="tag-hero__title">#@tag</h1>
            @if (Model.TotalCount > 0)
            {
                <p class="tag-hero__count">
                    <i class="fa-solid fa-layer-group"></i> @Model.TotalCount bài viết
                </p>
            }
        </div>
    </div>
</section>

@* ── Body: 2 cột ── *@
<section class="tag-section">
    <div class="container">
        <div class="tag-layout">
            @* ── CỘT TRÁI: danh sách tin ── *@
            <div class="tag-main">
                @if (!Model.Items.Any())
                {
                    <div class="no-data-section">
                        <i class="fa-regular fa-newspaper"></i>
                        <p>Chưa có bài viết nào với tag <strong>#@tag</strong>.</p>
                    </div>
                }
                else
                {
                    <div class="tag-news-list">
                        @foreach (var item in Model.Items)
                        {
                            var url = NewsUrlBuilder.BuildNewsUrl(item);
                            <article class="tag-news-item" data-aos="fade-up">
                                <a href="@url" class="tag-news-item__img-wrap">
                                    <img src="@(!string.IsNullOrEmpty(item.ImagePath) ? item.ImagePath : "/static/images/no-photo.png")"
                                         alt="@item.Title" loading="lazy" />
                                </a>
                                <div class="tag-news-item__body">
                                    <div class="tag-news-item__meta">
                                        <span class="tag-news-item__cat">@item.CategoryName</span>
                                        <time datetime="@item.PublishedDate.ToString("yyyy-MM-dd")">
                                            <i class="fa-regular fa-calendar"></i>
                                            @item.PublishedDate.ToString("dd/MM/yyyy")
                                        </time>
                                    </div>
                                    <h2 class="tag-news-item__title">
                                        <a href="@url">@item.Title</a>
                                    </h2>
                                    @if (!string.IsNullOrEmpty(item.Summary))
                                    {
                                        <p class="tag-news-item__summary">@Html.Raw(item.Summary)</p>
                                    }
                                    @* Tags *@
                                    @if (!string.IsNullOrEmpty(item.Tags))
                                    {
                                        <div class="tag-news-item__tags">
                                            @foreach (var t in item.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                            {
                                                <a href="/tin-tuc/tag?tag=@Uri.EscapeDataString(t)"
                                                   class="nd-tag @(string.Equals(t, tag, StringComparison.OrdinalIgnoreCase) ? "nd-tag--active" : "")">
                                                    #@t
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                    </div>

                    @* ── Phân trang ── *@
                    @if (Model.TotalPages > 1)
                    {
                        <nav class="pagination" aria-label="Phân trang">
                            @if (Model.HasPrev)
                            {
                                <a href="@baseUrl&page=@(Model.Page - 1)" class="pagination__btn" aria-label="Trang trước">
                                    <i class="fa-solid fa-chevron-left"></i>
                                </a>
                            }
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                if (p == Model.Page)
                                {
                                    <span class="pagination__btn pagination__btn--active">@p</span>
                                }
                                else if (p == 1 || p == Model.TotalPages || Math.Abs(p - Model.Page) <= 2)
                                {
                                    <a href="@baseUrl&page=@p" class="pagination__btn">@p</a>
                                }
                                else if (Math.Abs(p - Model.Page) == 3)
                                {
                                    <span class="pagination__ellipsis">…</span>
                                }
                            }
                            @if (Model.HasNext)
                            {
                                <a href="@baseUrl&page=@(Model.Page + 1)" class="pagination__btn" aria-label="Trang sau">
                                    <i class="fa-solid fa-chevron-right"></i>
                                </a>
                            }
                        </nav>
                    }
                }
            </div>

            @* ── CỘT PHẢI: sự kiện sidebar ── *@
            <aside class="tag-sidebar">
                <div class="tag-sidebar__sticky">

                    @if (upcomingEvents.Any())
                    {
                        <div class="nd-ev-section">
                            <div class="nd-ev-section__header">
                                <i class="fa-solid fa-calendar-days"></i>
                                <span>Sự kiện sắp diễn ra</span>
                            </div>
                            <div class="nd-ev-cards">
                                @foreach (var cat in upcomingEvents)
                                {
                                    <div class="nd-ev-card">
                                        <div class="nd-ev-card__banner">
                                            @if (!string.IsNullOrWhiteSpace(cat.AvatarUrl))
                                            {
                                                <img cdn-src="@cat.AvatarUrl" cdn-w="480" cdn-h="270"
                                                     alt="@cat.CatName" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="nd-ev-card__banner-placeholder">
                                                    <i class="fa-solid fa-calendar-days"></i>
                                                </div>
                                            }
                                            <div class="nd-ev-card__overlay">
                                                <div class="nd-ev-card__banner-content">
                                                    <h3 class="nd-ev-card__title">@cat.CatName</h3>
                                                    @if (cat.FromDate.HasValue || cat.EndDate.HasValue)
                                                    {
                                                        <div class="nd-ev-card__event-date">
                                                            <i class="fa-regular fa-calendar"></i>
                                                            @(cat.FromDate?.ToString("dd/MM/yyyy"))
                                                            @if (cat.FromDate.HasValue && cat.EndDate.HasValue) { <text> - </text> }
                                                            @(cat.EndDate?.ToString("dd/MM/yyyy"))
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        @if (cat.Events.Any())
                                        {
                                            <div class="nd-ev-card__locs">
                                                @foreach (var ev in cat.Events)
                                                {
                                                    <div class="nd-ev-card__loc-row">
                                                        <div class="nd-ev-card__loc-info">
                                                            <div class="nd-ev-card__loc-addr">
                                                                <i class="fa-solid fa-location-dot"></i>
                                                                <span>@(ev.Diadiem ?? ev.Title)</span>
                                                            </div>
                                                            @if (ev.Fromdatetime.HasValue || ev.Enddatetime.HasValue)
                                                            {
                                                                <div class="nd-ev-card__loc-dates">
                                                                    <i class="fa-regular fa-clock"></i>
                                                                    @if (ev.Fromdatetime.HasValue) { @ev.Fromdatetime.Value.ToString("HH:mm dd/MM/yyyy") }
                                                                    @if (ev.Fromdatetime.HasValue && ev.Enddatetime.HasValue) { <text> - </text> }
                                                                    @if (ev.Enddatetime.HasValue) { @ev.Enddatetime.Value.ToString("HH:mm dd/MM/yyyy") }
                                                                </div>
                                                            }
                                                            <div class="nd-ev-card__actions">
                                                                <a class="nd-ev-card__reg-btn"
                                                                   href="/dang-ky-su-kien?eventCatId=@cat.Id&eventId=@ev.Id">
                                                                    <i class="fa-solid fa-arrow-right"></i> Đăng ký
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <div class="nd-ev-card__footer">
                                            <a class="nd-ev-card__reg-general"
                                               href="/dang-ky-su-kien?eventCatId=@cat.Id">
                                                <i class="fa-solid fa-pen-to-square"></i> ĐĂNG KÝ CHUNG
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="nd-ev-reminder">
                                <i class="fa-regular fa-bell"></i>
                                <div class="nd-ev-reminder__text">
                                    <strong>Đừng bỏ lỡ!</strong>
                                    <span>Đăng ký ngay để nhận thông tin mới nhất về các sự kiện.</span>
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </aside>

        </div>
    </div>
</section>

@section Styles {
<style>
/* ── Hero ── */
.tag-hero {
    background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 100%);
    padding: 36px 0 28px;
    color: #fff;
}
.tag-hero__breadcrumb { color: rgba(255,255,255,.75); }
.tag-hero__breadcrumb a { color: rgba(255,255,255,.85); }
.tag-hero__breadcrumb a:hover { color: #fff; }
.tag-hero__breadcrumb i { margin: 0 6px; font-size: .7rem; }
.tag-hero__body { margin-top: 12px; }
.tag-hero__badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(255,255,255,.15); border-radius: 20px;
    padding: 4px 14px; font-size: .78rem; letter-spacing: .4px;
    color: #fff; margin-bottom: 10px;
}
.tag-hero__title { font-size: clamp(1.6rem,3vw,2.2rem); font-weight: 800; margin: 0 0 6px; }
.tag-hero__count { font-size: .85rem; opacity: .8; margin: 0; }

/* ── Section ── */
.tag-section { padding: 40px 0 60px; }

/* ── 2-col layout ── */
.tag-layout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 32px;
    align-items: start;
}
@@media (max-width: 1024px) { .tag-layout { grid-template-columns: 1fr 300px; gap: 24px; } }
@@media (max-width: 768px)  { .tag-layout { grid-template-columns: 1fr; } }

/* ── News list items ── */
.tag-news-list { display: flex; flex-direction: column; gap: 0; }
.tag-news-item {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 18px;
    padding: 20px 0;
    border-bottom: 1px solid #f0f0f0;
    transition: background .15s;
}
.tag-news-item:first-child { padding-top: 0; }
@@media (max-width: 600px) { .tag-news-item { grid-template-columns: 120px 1fr; gap: 12px; } }

.tag-news-item__img-wrap {
    display: block; aspect-ratio: 16/9; overflow: hidden;
    border-radius: 8px; flex-shrink: 0;
}
.tag-news-item__img-wrap img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform .3s;
}
.tag-news-item:hover .tag-news-item__img-wrap img { transform: scale(1.04); }

.tag-news-item__body { display: flex; flex-direction: column; gap: 6px; }
.tag-news-item__meta {
    display: flex; align-items: center; gap: 10px;
    flex-wrap: wrap; font-size: .78rem; color: #6b7280;
}
.tag-news-item__cat {
    background: #eff6ff; color: #2563eb;
    border-radius: 4px; padding: 2px 8px;
    font-size: .75rem; font-weight: 600;
}
.tag-news-item__title {
    font-size: 1rem; font-weight: 700; line-height: 1.4;
    margin: 0;
    display: -webkit-box; -webkit-line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden;
}
.tag-news-item__title a { color: #111; }
.tag-news-item__title a:hover { color: #2563eb; }
.tag-news-item__summary {
    font-size: .83rem; color: #6b7280; line-height: 1.5; margin: 0;
    display: -webkit-box; -webkit-line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden;
}
.tag-news-item__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 2px; }

/* ── Tag badge ── */
.nd-tag--active {
    background: #2563eb !important;
    color: #fff !important;
    border-color: #2563eb !important;
}

/* ── Sidebar sticky ── */
.tag-sidebar__sticky {
    position: sticky;
    top: 90px;
}
</style>
}
