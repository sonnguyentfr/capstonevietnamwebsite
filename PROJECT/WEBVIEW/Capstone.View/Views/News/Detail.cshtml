@using NVCMS.WebView.Data.ViewModels
@model NewsDetailViewModel

@{
    ViewData["Title"] = Model.MetaTitle ?? Model.Title;
    var pageUrl = ViewData["CanonicalUrl"]?.ToString() ?? string.Empty;
    var encodedUrl   = Uri.EscapeDataString(pageUrl);
    var encodedTitle = Uri.EscapeDataString(Model.Title);
}

@* ── COVER ── *@
@if (!string.IsNullOrEmpty(Model.ImagePath))
{
    <div class="nd-cover">
        <img src="@Model.ImagePath" alt="@Model.Title" loading="eager" />
        <div class="nd-cover__overlay"></div>
    </div>
}

<div class="nd-wrap">
    <div class="container">

        @* ── BREADCRUMB ── *@
        <nav class="breadcrumb nd-breadcrumb" aria-label="breadcrumb">
            <a href="/">Trang chủ</a>
            <i class="fa-solid fa-chevron-right"></i>
            <a href="/cam-nang-va-tin-tuc">Tin tức</a>
            <i class="fa-solid fa-chevron-right"></i>
            <a href="/tin-tuc/@(Model.CategorySlug)-@Model.CategoryId">@Model.CategoryName</a>
            <i class="fa-solid fa-chevron-right"></i>
            <span>@Model.Title</span>
        </nav>

        @* ── HEADER ── *@
        <header class="nd-header">
            <span class="nd-cat-badge">@Model.CategoryName</span>
            <h1 class="nd-title">@Model.Title</h1>
            <div class="nd-meta">
                @if (!string.IsNullOrEmpty(Model.Tacgia))
                {
                    <span><i class="fa-solid fa-pen-nib"></i> @Model.Tacgia</span>
                }
                <time datetime="@Model.PublishedDate.ToString("yyyy-MM-ddTHH:mm:ss")">
                    <i class="fa-regular fa-calendar"></i>
                    @Model.PublishedDate.ToString("dd/MM/yyyy")
                </time>
                <span><i class="fa-regular fa-clock"></i> @Model.PublishedDate.ToString("HH:mm")</span>
                <span><i class="fa-regular fa-eye"></i> @Model.ViewCount lượt xem</span>
            </div>
        </header>

        @* ── BODY: 2 cột ── *@
        <div class="nd-body">

            @* ── CỘT TRÁI: share + nội dung ── *@
            <div class="nd-main">

                @* Share bar dọc *@
                <div class="nd-share" id="nd-share-bar">
                    <span class="nd-share__label">Chia sẻ</span>
                    <a class="nd-share__btn nd-share__fb"
                       href="https://www.facebook.com/sharer/sharer.php?u=@encodedUrl"
                       target="_blank" rel="noopener" title="Chia sẻ Facebook">
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>
                    <a class="nd-share__btn nd-share__tw"
                       href="https://twitter.com/intent/tweet?url=@encodedUrl&text=@encodedTitle"
                       target="_blank" rel="noopener" title="Chia sẻ Twitter / X">
                        <i class="fa-brands fa-x-twitter"></i>
                    </a>
                    <a class="nd-share__btn nd-share__li"
                       href="https://www.linkedin.com/sharing/share-offsite/?url=@encodedUrl"
                       target="_blank" rel="noopener" title="Chia sẻ LinkedIn">
                        <i class="fa-brands fa-linkedin-in"></i>
                    </a>
                    <button class="nd-share__btn nd-share__copy" onclick="ndCopyLink()" title="Sao chép liên kết">
                        <i class="fa-solid fa-link" id="nd-copy-icon"></i>
                    </button>
                </div>

                @* Nội dung chính *@
                <article class="nd-content-wrap">

                    @* Table of contents (JS sẽ inject vào đây) *@
                    <div id="nd-toc" class="nd-toc" style="display:none">
                        <div class="nd-toc__header">
                            <i class="fa-solid fa-list-ul"></i> Mục lục
                            <button class="nd-toc__toggle" onclick="ndTocToggle(this)" title="Thu gọn">
                                <i class="fa-solid fa-chevron-up"></i>
                            </button>
                        </div>
                        <nav id="nd-toc-nav" class="nd-toc__nav"></nav>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Summary))
                    {
                        <div class="nd-summary page-tomtat">
                            @Html.Raw(Model.Summary)
                        </div>
                    }

                    <div class="nd-content page-noidung" id="nd-content">
                        @Html.Raw(Model.Content)
                    </div>

                    @if (!string.IsNullOrEmpty(Model.SourceText))
                    {
                        <p class="nd-source"><em>Nguồn: @Model.SourceText</em></p>
                    }

                    @* Tags *@
                    @if (!string.IsNullOrEmpty(Model.Tags))
                    {
                        <div class="nd-tags">
                            <i class="fa-solid fa-tags"></i>
                            @foreach (var tag in Model.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                            {
                                <a href="/tin-tuc?tag=@Uri.EscapeDataString(tag)" class="nd-tag">@tag</a>
                            }
                        </div>
                    }
                    @* Trường liên quan *@
                    @if (Model.RelatedSchools.Any())
                    {
                        <section class="nd-related-schools">
                            <h3 class="nd-related__title"><i class="fa-solid fa-school"></i> Trường liên quan</h3>
                            <div class="nd-schools-grid">
                                @foreach (var s in Model.RelatedSchools)
                                {
                                    <a href="/truong-doi-tac/@(s.Slug)-@s.Id" class="nd-school-card">
                                        <div class="nd-school-card__logo">
                                            @if (!string.IsNullOrEmpty(s.LogoUrl))
                                            {
                                                <img src="@s.LogoUrl" alt="@s.NameofSchool" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="nd-school-card__logo-placeholder"><i class="fa-solid fa-school"></i></div>
                                            }
                                        </div>
                                        <div class="nd-school-card__info">
                                            <p class="nd-school-card__name">@s.NameofSchool</p>
                                            @if (!string.IsNullOrEmpty(s.CountryName))
                                            {
                                                <span class="nd-school-card__country"><i class="fa-solid fa-location-dot"></i> @s.CountryName</span>
                                            }
                                        </div>
                                    </a>
                                }
                            </div>
                        </section>
                    }
                </article>
            </div>

            @* ── CỘT PHẢI: sidebar 8 tin ── *@
            <aside class="nd-sidebar" id="nd-sidebar">
                <div class="nd-sidebar__sticky">
                    <div class="nd-sidebar__block">
                        <h4 class="nd-sidebar__heading">
                            <i class="fa-solid fa-newspaper"></i> Tin cùng chuyên mục
                        </h4>
                        <div class="nd-sidebar__news">
                            @foreach (var r in Model.RelatedNews.Take(8))
                            {
                                <a href="/tin-tuc/@(r.Slug)-@r.NewId" class="nd-snews-item @(r.NewId == Model.NewId ? "nd-snews-item--active" : "")">
                                    @if (!string.IsNullOrEmpty(r.ImagePath))
                                    {
                                        <div class="nd-snews-item__img">
                                            <img src="@r.ImagePath" alt="@r.Title" loading="lazy" />
                                        </div>
                                    }
                                    <div class="nd-snews-item__info">
                                        <time>@r.PublishedDate.ToString("dd/MM/yyyy")</time>
                                        <p>@r.Title</p>
                                    </div>
                                </a>
                            }
                        </div>
                        <a href="/tin-tuc/@(Model.CategorySlug)-@Model.CategoryId" class="nd-sidebar__more">
                            Xem tất cả <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </aside>

        </div>@* /nd-body *@
    </div>@* /container *@
</div>@* /nd-wrap *@

@* ── TOC sticky floating (chạy theo trang) ── *@
<div id="nd-toc-float" class="nd-toc-float" style="display:none">
    <button class="nd-toc-float__toggle" onclick="ndTocFloatToggle()" title="Mục lục">
        <i class="fa-solid fa-list-ul"></i>
    </button>
    <div class="nd-toc-float__panel" id="nd-toc-float-panel">
        <div class="nd-toc-float__heading">Mục lục</div>
        <nav id="nd-toc-float-nav"></nav>
    </div>
</div>

@section Scripts {
<script type="application/ld+json">
{
    "@@context": "https://schema.org",
    "@@type": "NewsArticle",
    "headline": "@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MetaTitle ?? Model.Title).Trim('"'))",
    "description": "@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MetaDescription ?? string.Empty).Trim('"'))",
    "image": "@(Model.MetaImage ?? Model.ImagePath ?? string.Empty)",
    "datePublished": "@Model.PublishedDate.ToString("yyyy-MM-ddTHH:mm:ssZ")",
    "author": { "@@type": "Person", "name": "@(Model.Tacgia ?? "Capstone Vietnam")" },
    "publisher": {
        "@@type": "Organization",
        "name": "Capstone Vietnam",
        "logo": { "@@type": "ImageObject", "url": "" }
    },
    "mainEntityOfPage": { "@@type": "WebPage", "@@id": "@pageUrl" }
}
</script>
<script>
// ── Copy link ──────────────────────────────────────────────
function ndCopyLink() {
    navigator.clipboard.writeText(window.location.href).then(function () {
        var icon = document.getElementById('nd-copy-icon');
        icon.className = 'fa-solid fa-check';
        setTimeout(function () { icon.className = 'fa-solid fa-link'; }, 2000);
    });
}

// ── Table of Contents ─────────────────────────────────────
(function () {
    var content = document.getElementById('nd-content');
    if (!content) return;

    var headings = content.querySelectorAll('h1,h2,h3');
    if (headings.length < 2) return;

    // Build TOC tree
    function buildNav(headings, containerId) {
        var nav = document.getElementById(containerId);
        if (!nav) return;
        var ul = document.createElement('ul');
        var stack = [{ level: 0, ul: ul }];

        headings.forEach(function (h, i) {
            var level = parseInt(h.tagName[1]);
            var id = 'nd-h-' + i;
            h.id = id;

            // Add anchor icon inside heading
            var anchor = document.createElement('a');
            anchor.className = 'nd-heading-anchor';
            anchor.href = '#' + id;
            anchor.innerHTML = '<i class="fa-solid fa-hashtag"></i>';
            h.style.position = 'relative';
            h.appendChild(anchor);

            // Pop stack to correct level
            while (stack.length > 1 && stack[stack.length - 1].level >= level)
                stack.pop();

            var li = document.createElement('li');
            li.className = 'nd-toc__item nd-toc__item--h' + level;

            var a = document.createElement('a');
            a.href = '#' + id;
            a.textContent = h.textContent.replace(/\s*#\s*$/, '').trim();
            a.addEventListener('click', function (e) {
                e.preventDefault();
                h.scrollIntoView({ behavior: 'smooth', block: 'start' });
                history.pushState(null, '', '#' + id);
            });
            li.appendChild(a);

            // If deeper level, create nested ul
            if (level > stack[stack.length - 1].level) {
                var nested = document.createElement('ul');
                stack[stack.length - 1].ul.lastElementChild
                    ? stack[stack.length - 1].ul.lastElementChild.appendChild(nested)
                    : stack[stack.length - 1].ul.appendChild(nested);
                stack.push({ level: level, ul: nested });
            }

            stack[stack.length - 1].ul.appendChild(li);
        });

        nav.appendChild(ul);
    }

    buildNav(headings, 'nd-toc-nav');
    buildNav(headings, 'nd-toc-float-nav');

    document.getElementById('nd-toc').style.display = '';
    document.getElementById('nd-toc-float').style.display = '';

    // ── Active heading on scroll ──────────────────────────
    var tocLinks     = document.querySelectorAll('#nd-toc-nav a, #nd-toc-float-nav a');
    var headingIds   = Array.from(headings).map(function (h) { return h.id; });

    var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            tocLinks.forEach(function (a) {
                a.classList.toggle('active', a.getAttribute('href') === '#' + entry.target.id);
            });
        });
    }, { rootMargin: '-10% 0px -80% 0px' });

    headings.forEach(function (h) { observer.observe(h); });
})();

// ── TOC collapse ──────────────────────────────────────────
function ndTocToggle(btn) {
    var nav = document.getElementById('nd-toc-nav');
    var icon = btn.querySelector('i');
    var collapsed = nav.style.display === 'none';
    nav.style.display = collapsed ? '' : 'none';
    icon.className = collapsed ? 'fa-solid fa-chevron-up' : 'fa-solid fa-chevron-down';
}

// ── TOC float toggle ──────────────────────────────────────
function ndTocFloatToggle() {
    var panel = document.getElementById('nd-toc-float-panel');
    panel.classList.toggle('is-open');
}

// ── Sticky share bar ──────────────────────────────────────
(function () {
    var share = document.getElementById('nd-share-bar');
    if (!share) return;
    var origin = share.getBoundingClientRect().top + window.scrollY;
    window.addEventListener('scroll', function () {
        share.classList.toggle('nd-share--sticky', window.scrollY > origin);
    }, { passive: true });
})();
</script>
}

