<div class="banner-slider-wrapper">
  <div class="banner-slider slick_slider slick-arrows-style1">
    <!-- banner-slide -->
    [LIST]
    <div class="banner-slide lazyload" style="background: url([IMAGE])">
      <div class="banner-caption">
        <div class="info">
          <div class="container">
            <div class="d-lg-flex justify-content-end">
              <div class="mb-40 res-991-mt-0">
                <div class="banner-text right-content ttm-textcolor-white">
                  <div class="mt-5 mb-10">
                    <h2 class="slideInLeft animated">[NAME]</h2>
                    <h2 class="slideInLeft animated delay-1s">[DESCRIPTION]</h2>
                  </div>
                </div>
                <div class="fadeInUp animated delay-3s mt-15">
                  <a href="[URL]" class="ttm-btn ttm-btn-size-md ttm-btn-shape-square ttm-btn-style-border ttm-btn-color-white mr-3">Xem tiếp</a>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
    [/LIST]
  </div>
</div>