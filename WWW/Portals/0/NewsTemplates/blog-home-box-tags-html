<div class="box-small">
    <h2 class="title">
        <a href="[CATURL]">
            [CATNAME]
        </a>
    </h2>
    [LIST_TOP]
    <div class="single-post-wrap">
        <div class="thumb">
            <a href="[URL]">
                <img src="[IMAGE]" alt="[NAMEALT]" />
            </a>
        </div>
        <div class="details">
            <h6 class="title text-limit-2-row"><a href="[URL]">[NAME]</a></h6>
            <div class="post-meta-single">
                <p><i class="fa fa-clock-o"></i>[DATE]</p>
            </div>
            <p class="text-limit-3-row">
                [DESCRIPTION]
            </p>
        </div>
    </div>
    [/LIST_TOP]
    [LIST_MORE]
    <div class="single-post-list-wrap">
        <div class="media">
            <div class="media-left">
                <a href="[URL]">
                <img src="[IMAGE]" alt="[NAMEALT]"></a>
            </div>
            <div class="media-body">
                <div class="details">
                    <div class="post-meta-single">
                        <ul>
                            <li><i class="fa fa-clock-o"></i>[DATE]</li>
                        </ul>
                    </div>
                    <h6 class="title"><a href="[URL]">[NAME]</a></h6>
                </div>
            </div>
        </div>
    </div>
    [/LIST_MORE]
</div>