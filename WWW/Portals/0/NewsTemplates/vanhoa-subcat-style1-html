<div class="container mb-50">
    <div class="sidebar-widget loop-grid">
        <div class="row">
            <div class="col-lg-4 col-md-12">
                <div class="widget-header position-relative mb-30">
                    <h5 class="widget-title mb-30 text-uppercase color4 font-weight-ultra">[CATNAME]</h5>
                    <div class="letter-background">[CATNAME]</div>
                </div>
            </div>

        </div>
        <div class="row">
            <div class="col-12">
                <div class="pt-30 bt-1 border-color-1"></div>
            </div>
            [LIST_TOP]
		
            <div class="col-lg-3 col-md-6 col-sm-12 mb-30">
                <div class="post-thumb position-relative thumb-overlay hover-box-shadow-2 mb-10">
                    <div class="img-hover-slide border-radius-5 position-relative" style="background-image: url([IMAGE])">
                        <a class="img-link" href="[URL]?utm_source=dm&utm_medium=vanhoa&utm_campaign=cat"></a>
                    </div>
                </div>
                <div class="post-content">

                    <h4 class="post-title">
                        <a href="[URL]?utm_source=dm&utm_medium=vanhoa&utm_campaign=cat">[NAME]</a>
                    </h4>
                    <div class="entry-meta meta-1 font-small color-grey mt-15 mb-15">
                        <span class="post-on">[DATE]</span>

                    </div>
                </div>
            </div>
            [/LIST_TOP]
			[LIST_MORE]
		
            <div class="col-lg-4 col-md-6 col-sm-12">
                <div class="post-thumb position-relative thumb-overlay hover-box-shadow-2 mb-30">
                    <div class="img-hover-slide border-radius-5 position-relative" style="background-image: url([IMAGE])">
                        <a class="img-link" href="[URL]?utm_source=dm&utm_medium=vanhoa&utm_campaign=cat"></a>
                    </div>
                </div>
                <div class="post-content">
                    <h4 class="post-title">
                        <a href="[URL]?utm_source=dm&utm_medium=vanhoa&utm_campaign=cat">[NAME]</a>
                    </h4>
                    <div class="entry-meta meta-1 font-small color-grey mt-15 mb-15">
                        <span class="post-on">[DATE]</span>
                    </div>
                </div>
            </div>
            [/LIST_MORE]
		
            <div class="col-12">
                <div class="mt-30 bt-1 border-color-1"></div>
            </div>
        </div>
    </div>
</div>