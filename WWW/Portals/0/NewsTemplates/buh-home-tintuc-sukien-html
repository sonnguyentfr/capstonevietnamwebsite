<div class="justify-content-between">
    <div class="widget-header position-relative0">
        <h5 class="widget-title  text-uppercase color4 font-weight-ultra"><a href="[CATURL]">[CATNAME]</a></h5>
    </div>
</div>
<!-- Tab content -->

<!-- Tab one -->
<div class="block-tab-item post-module-2 post-module-1">
    <div class="row">
        <div class="col-md-6">
            [LIST_TOP]
                <div class="post-block-style">
                    <div class="post-thumb position-relative thumb-overlay mb-15">
                        <div class="img-hover-slide border-radius-5 position-relative" style="background-image: url([IMAGE])">
                            <a class="img-link" href="[URL]"></a>
                        </div>
                    </div>
                    <div class="post-content">
                        <h4 class="post-title text-limit-3-row">
                            <a href="[URL]">[NAME]</a>
                        </h4>
                        <div class="entry-meta meta-1 font-small color-grey mt-15 mb-15">
                            <span class="post-on"><i class="ti-marker-alt"></i>[DATE]</span>
                            <span class="hit-count"><i class="ti-bolt"></i>[VIEWCOUNT]</span>
                        </div>
                        <p class="font-medium d-none d-lg-block text-limit-3-row">[DESCRIPTION]</p>
                    </div>
                </div>
            [/LIST_TOP]
        </div>
        <div class="col-md-6">
            <div class="hometintucsukien-tinkhac sm-grid-content">
                <ul class="list-post">
                    [LIST_MORE]
                    <li class="mb-30">
                        <div class="d-flex">
                            <div class="post-thumb d-flex mr-15 border-radius-5 img-hover-scale">
                                <a href="[URL]">
                                    <img class='lazy' src='https://fileserver.buh.edu.vn/no-photo.png?' data-src="[IMAGE]" alt="[NAMEALT]">
                                </a>
                            </div>
                            <div class="post-content media-body">
                                <h6 class="post-title mb-10 text-limit-4-row"><a href="[URL]">[NAME]</a></h6>
                                <div class="entry-meta meta-1 font-x-small color-grey">
                                    <span class="post-on">[DATE]</span>
                                </div>
                            </div>
                        </div>
                    </li>
                    [/LIST_MORE]
                </ul>

            </div>

        </div>
    </div>
</div>


<!-- End Tab content-->