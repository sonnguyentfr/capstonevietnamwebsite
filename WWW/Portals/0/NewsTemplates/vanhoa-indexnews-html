<div class="widget-header position-relative mb-30">
    <h5 class="widget-title mb-30 text-uppercase color1 font-weight-ultra">[CATNAME]</h5>
    <div class="letter-background">Latest</div>
</div>
<div class="loop-list">
    [LIST_ITEM]
    <article class="row mb-20">
        <div class="col-md-4">
            <div class="post-thumb position-relative thumb-overlay">
                <div class="img-hover-slide border-radius-5 position-relative" style="background-image: url([IMAGE])">
                    <a class="img-link" href="[URL]?utm_source=dm&utm_medium=vanhoa&utm_campaign=cat"></a>
                </div>
            </div>
        </div>
        <div class="col-md-8 align-center-vertical">
            <div class="post-content">
                <h4 class="post-title text-limit-2-row">
                    <a href="[URL]?utm_source=dm&utm_medium=vanhoa&utm_campaign=cat">[NAME]</a>
                </h4>
                <div class="entry-meta meta-1 font-small color-grey mt-15 mb-15">
                    <span class="post-on"><i class="ti-marker-alt"></i>[DATE]</span>
                </div>
                <p class="font-medium text-limit-3-row">[DESCRIPTION] </p>
            </div>
        </div>
    </article>
    [/LIST_ITEM]
</div>
