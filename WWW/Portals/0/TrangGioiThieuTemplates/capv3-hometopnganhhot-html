<div class="row">
    [LIST_ITEM]
    <div class="col-lg-4 col-md-4">
        <!-- featured-imagebox -->
        <div class="featured-icon-box icon-align-top-content style9">
            <div class="featured-icon">
                <div class="ttm-icon ttm-icon_element-onlytxt ttm-icon_element-color-skincolor ttm-icon_element-size-lg">
                    <img src="[IMAGE]" alt="[NAME]" />
                </div>
            </div>
            <div class="featured-content">
                <div class="featured-title">
                    <h5><a href="[URL]">[NAME]</a></h5>
                </div>
                <div class="featured-desc">
                    <p>[DESCREPTION]</p>
                </div>
                <a class="ttm-btn btn-inline ttm-btn-size-md ttm-icon-btn-right ttm-btn-color-skincolor" href="[URL]" title="">xem tiếp<i class="fa fa-chevron-right"></i></a>
            </div>
        </div>
        <!-- featured-imagebox end-->
    </div>
    [/LIST_ITEM]
</div>